  <attributes>
    <name>СписокЗаявок</name>
    <title>
      <key>ru</key>
      <value>Список заявок</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ЗаказыРезервыОстатки.Счет.Номер,
	ЗаказыРезервыОстатки.Счет.Ответственный,
	ЗаказыРезервыОстатки.Счет.ДатаОтгрузки,
	ЗаказыРезервыОстатки.КоличествоОстаток,
	ЗаказыРезервыОстатки.Счет.Товары.(
		Цена),
	ЗаказыРезервыОстатки.Характеристики.Владелец,
	ЗаказыРезервыОстатки.Характеристики.Цвет,
	ЗаказыРезервыОстатки.Характеристики.RAL,
	ЗаказыРезервыОстатки.Характеристики.Фасовка
ИЗ
	РегистрНакопления.ЗаказыРезервы.Остатки КАК ЗаказыРезервыОстатки</queryText>
      <mainTable>AccumulationRegister.ЗаказыРезервы.Balance</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
