  <attributes>
    <name>СписокОстатков</name>
    <title>
      <key>ru</key>
      <value>Список остатков</value>
    </title>
    <id>5</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ОстаткиМатериаловОстатки.Наименование КАК Наименование,
	ОстаткиМатериаловОстатки.Партия КАК Партия,
	ОстаткиМатериаловОстатки.ОстатокОстаток КАК ОстатокОстаток,
	
	// Подтягиваем характеристики конкретной партии
    ЕСТЬNULL(Характеристики.Цвет, &quot;—&quot;) КАК Цвет,
    ЕСТЬNULL(Характеристики.RAL, &quot;—&quot;) КАК RAL,
    ЕСТЬNULL(Характеристики.Фасовка, &quot;—&quot;) КАК Фасовка,  
    
	// Справочная цена из Регистра Сведений
    ЕСТЬNULL(Цены.Цена, 0) КАК Цена,
    
	// Подтягиваем данные для формулы состава
    ЕСТЬNULL(Составы.ВесБазы, 0) КАК ВесБазы,
    ЕСТЬNULL(Составы.Вес1, 0) КАК Вес1,
    ЕСТЬNULL(Составы.Вес2, 0) КАК Вес2,
    ЕСТЬNULL(Составы.Вес3, 0) КАК Вес3
ИЗ
	РегистрНакопления.ОстаткиМатериалов.Остатки(
		, 
		Наименование.ТипНоменклатуры В (
		ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Продукция), 
		ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Комплект))
		) КАК ОстаткиМатериаловОстатки 
	
	// Присоединяем паспорт партии
	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ХарактеристикиПартий КАК Характеристики
		ПО ОстаткиМатериаловОстатки.Партия = Характеристики.Партия
		И ОстаткиМатериаловОстатки.Наименование = Характеристики.Номенклатура
			
	// Присоединяем справочную цену (учитываем Партию)
    	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныМатериалов КАК Цены
        	ПО ОстаткиМатериаловОстатки.Партия = Цены.Партия
        	И ОстаткиМатериаловОстатки.Наименование = Цены.Номенклатура
			
	// Присоединяем эталонный состав для расчета комплектов
    	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоставыКомплектов КАК Составы
        	ПО ОстаткиМатериаловОстатки.Наименование = Составы.НоменклатураКомплекта
</queryText>
      <mainTable>AccumulationRegister.ОстаткиМатериалов.Balance</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
