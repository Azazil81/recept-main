#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
    // 1. Получить ссылки на рецептуры
	Данные = ПолучитьДанныеСравнения(Параметры.СписокРецептур);

    // 2. Построить табличный документ
	ПостроитьТабДокумент(Данные);
	
	Элементы.ТабДокумент.Редактирование = Ложь;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТабДокументПриАктивизации(Элемент)
	
	РедактированиеРазрешено = Ложь;
	Если КолонкаКлона > 0 Тогда
		Для Каждого Обл Из Элемент.ПолучитьВыделенныеОбласти() Цикл
			Если ТипЗнч(Обл) = Тип("ОбластьЯчеекТабличногоДокумента")
				И Обл.Лево = КолонкаКлона И Обл.Право = КолонкаКлона
				И Обл.Верх >= 1 И Обл.Низ <= СтрокаВсего - 1 Тогда
				РедактированиеРазрешено = Истина;
			КонецЕсли;
			Прервать;
		КонецЦикла;
	КонецЕсли;
	Элементы.ТабДокумент.Редактирование = РедактированиеРазрешено;
	
	ОбщаяСумма = 0;
	КолвоЯчеек = 0;
	МаксимальноЯчеек = 5000; // Чтобы не зависнуть
	
	Для Каждого Область Из Элемент.ПолучитьВыделенныеОбласти() Цикл
		
		Если ТипЗнч(Область) <> Тип("ОбластьЯчеекТабличногоДокумента") Тогда
			Продолжить;
		КонецЕсли;
		
		// Проверка на гигантские области (выделение всей колонки)
		Ширина = Область.Право - Область.Лево + 1;
		Высота = Область.Низ - Область.Верх + 1;
		
		Если (Ширина * Высота) > МаксимальноЯчеек Тогда
			СуммаВыделенныхЯчеек = 0;
			Возврат;
		КонецЕсли;
		
		Для НомерСтроки = Область.Верх По Область.Низ Цикл
			Для НомерКолонки = Область.Лево По Область.Право Цикл
				
				// Получаем ячейку из данных (из реквизита ТабДокумент)
				Ячейка = ТабДокумент.Область(НомерСтроки, НомерКолонки);
				
				Значение = 0;
				НайденЧисловойТип = Ложь;
								
				Если Не НайденЧисловойТип И Не ПустаяСтрока(Ячейка.Текст) Тогда
					ТекстДляПарсинга = СтрЗаменить(Ячейка.Текст, Символ(160), ""); // Неразрывный пробел
					ТекстДляПарсинга = СтрЗаменить(ТекстДляПарсинга, " ", "");    // Обычный пробел
					
					Попытка
						Значение = Число(ТекстДляПарсинга);
						НайденЧисловойТип = Истина;
					Исключение
						Значение = 0;
					КонецПопытки;
				КонецЕсли;
				
				Если НайденЧисловойТип Тогда
					ОбщаяСумма = ОбщаяСумма + Значение;
					КолвоЯчеек = КолвоЯчеек + 1;
				КонецЕсли;
				
			КонецЦикла;
		КонецЦикла;
		
	КонецЦикла;
	
	// Вывод результата в реквизит СуммаВыделенныхЯчеек
	Если КолвоЯчеек > 1 Тогда
		СуммаВыделенныхЯчеек = ОбщаяСумма;//СтрШаблон("Сумма: %1 (Кол-во: %2)", Формат(ОбщаяСумма, "ЧЦ=15; ЧДЦ=2"), КолвоЯчеек);
	ИначеЕсли КолвоЯчеек = 1 Тогда
		// Для одной ячейки обычно сумму не выводят, как в Excel, но можно
		СуммаВыделенныхЯчеек = ОбщаяСумма; //"Значение: " + ОбщаяСумма;
	Иначе
		СуммаВыделенныхЯчеек = 0; //"";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТабДокументПриИзменении(Элемент)
	Если КолонкаКлона = 0 Тогда
		Возврат;
	КонецЕсли;
	ПересчитатьИтогиКлона();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КлонированиеРецептуры(Команда)
	
	КолонкиРецептур = Новый Соответствие;
	ОшибкаВалидации = Ложь;
	ПустоеВыделение = Истина;
	
	Для Каждого Область Из Элементы.ТабДокумент.ПолучитьВыделенныеОбласти() Цикл
		Если ТипЗнч(Область) <> Тип("ОбластьЯчеекТабличногоДокумента") Тогда
			Продолжить;
		КонецЕсли;
		
		ПустоеВыделение = Ложь;
		
		Для Кол = Область.Лево По Область.Право Цикл
			Если Кол < 4 Или Кол > ПоследняяКолонкаРецептур Тогда
				ОшибкаВалидации = Истина;
				Прервать;
			КонецЕсли;
			КолонкиРецептур.Вставить(Кол, Истина);
		КонецЦикла;
		
		Если ОшибкаВалидации Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	КоличествоКолонок = 0;
	НомерКолонки = 0;
	Для Каждого КЗ Из КолонкиРецептур Цикл
		КоличествоКолонок = КоличествоКолонок + 1;
		НомерКолонки = КЗ.Ключ;
	КонецЦикла;
	
	Если ОшибкаВалидации Или ПустоеВыделение Или КоличествоКолонок <> 1 Тогда
		ПоказатьПредупреждение(, "Нужно выбрать только 1 рецептуру");
		Возврат;
	КонецЕсли;
	
	Если КолонкаКлона > 0 Тогда
		Оповещение = Новый ОписаниеОповещения("КлонированиеПослеВопроса", ЭтотОбъект, НомерКолонки);
		ПоказатьВопрос(Оповещение, "Редактируемая рецептура будет перезаполнена из копируемой", РежимДиалогаВопрос.ОКОтмена);
		Возврат;
	КонецЕсли;
	
	КлонироватьКолонкуНаСервере(НомерКолонки);
	
КонецПроцедуры

&НаКлиенте
Процедура КлонированиеПослеВопроса(Результат, НомерКолонки) Экспорт
	Если Результат = КодВозвратаДиалога.ОК Тогда
		КлонироватьКолонкуНаСервере(НомерКолонки);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьДанныеСравнения(СписокРецептур)

    // -----------------------------
    // 1. Получаем состав рецептур
    // -----------------------------
    
Запрос = Новый Запрос;
Запрос.Текст =
	"ВЫБРАТЬ
	|	РецептСостав.Ссылка КАК Рецептура,
	|	РецептСостав.Ссылка.Наименование КАК НаименованиеРецептуры,
	|	РецептСостав.Ссылка.Переработка КАК Переработка,
	|	РецептСостав.НомерСтроки КАК НомерСтроки,
	|	РецептСостав.Материал,
	|	РецептСостав.Материал.Наименование,
	|	РецептСостав.КоличествоНаТонну КАК Количество,
	|	РецептСостав.Материал.ЕдиницаИзмеренияСырья КАК ЕдиницаИзмерения
	|ИЗ
	|	Документ.Рецепт.Состав КАК РецептСостав
	|ГДЕ
	|	РецептСостав.Ссылка В (&СписокРецептур)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки,
	|	Рецептура";

Запрос.УстановитьПараметр("СписокРецептур", СписокРецептур);

РезультатЗапроса = Запрос.Выполнить();

Выборка = РезультатЗапроса.Выбрать();

	ТаблицаКомпонентов = Новый Соответствие;   // Материал → Соответствие(Рецептура → Количество)
	Рецептуры = Новый Соответствие;            // Ссылка → Наименование
	ПорядокРецептур = Новый Массив;
	ПорядокКомпонентов = Новый Массив;
	ЦеныМатериалов = Новый Соответствие;
	ОстаткиМатериалов = Новый Соответствие;
	ПереработкаРецептур = Новый Соответствие;  // Ссылка → Переработка (руб)
	ЕдиницыМатериалов = Новый Соответствие;   // Материал → ЕдиницаИзмерения

	Пока Выборка.Следующий() Цикл
		
		// порядок рецептур
		Если Рецептуры.Получить(Выборка.Рецептура) = Неопределено Тогда
			Рецептуры.Вставить(Выборка.Рецептура, Выборка.НаименованиеРецептуры);
			ПорядокРецептур.Добавить(Выборка.Рецептура);
			ПереработкаРецептур.Вставить(Выборка.Рецептура, ?(Выборка.Переработка = Неопределено, 0, Выборка.Переработка));
		КонецЕсли;
	
		// пустые строки состава пропускаем
		Если Выборка.Материал = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		// порядок компонентов как в документе
		Если ПорядокКомпонентов.Найти(Выборка.Материал) = Неопределено Тогда
			ПорядокКомпонентов.Добавить(Выборка.Материал);
			ЕдиницыМатериалов.Вставить(Выборка.Материал, Выборка.ЕдиницаИзмерения);
		КонецЕсли;
		
		// матрица количеств
		Если ТаблицаКомпонентов.Получить(Выборка.Материал) = Неопределено Тогда
			ТаблицаКомпонентов.Вставить(Выборка.Материал, Новый Соответствие);
		КонецЕсли;
		
		// цены материалов
		Если ЦеныМатериалов.Получить(Выборка.Материал) = Неопределено Тогда
			Цена = РаботаСоСправочниками.ЦенаМатериалов(ТекущаяДатаСеанса(), Выборка.Материал);
			ЦеныМатериалов.Вставить(Выборка.Материал, Цена);
		КонецЕсли;
		
		// остатки материалов
		Если ОстаткиМатериалов.Получить(Выборка.Материал) = Неопределено Тогда
			Остаток = РаботаСоСправочниками.ОстаткиМатериалов(Выборка.Материал);
			ОстаткиМатериалов.Вставить(Выборка.Материал, Остаток);
		КонецЕсли;
	
		ТаблицаКомпонентов[Выборка.Материал].Вставить(Выборка.Рецептура, Выборка.Количество);
		
	КонецЦикла;

	 // --------------------------------
    // 3. Возврат результата
    // --------------------------------

	Данные = Новый Структура;
	Данные.Вставить("Рецептуры", Рецептуры);
	Данные.Вставить("ПорядокРецептур", ПорядокРецептур);
	Данные.Вставить("ПорядокКомпонентов", ПорядокКомпонентов);
	Данные.Вставить("ТаблицаКомпонентов", ТаблицаКомпонентов);
	Данные.Вставить("ЦеныМатериалов", ЦеныМатериалов);
	Данные.Вставить("ОстаткиМатериалов", ОстаткиМатериалов);
	Данные.Вставить("ПереработкаРецептур", ПереработкаРецептур);
	Данные.Вставить("ЕдиницыМатериалов", ЕдиницыМатериалов);
	
	Возврат Данные;
	
КонецФункции

&НаСервере
Процедура ПостроитьТабДокумент(Данные)
	
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Рецептуры = Данные.Рецептуры;
	Компоненты = Данные.ТаблицаКомпонентов;
	ПорядокРецептур = Данные.ПорядокРецептур;
	ПорядокКомпонентов = Данные.ПорядокКомпонентов;
	ЦеныМатериалов = Данные.ЦеныМатериалов;
	ОстаткиМатериалов = Данные.ОстаткиМатериалов;
	ПереработкаРецептур = Данные.ПереработкаРецептур;
	ЕдиницыМатериалов = Данные.ЕдиницыМатериалов;
	
	ТабДокумент.Очистить();
	
	КоличествоРецептур = ПорядокРецептур.Количество();
	ПоследняяКолонка = 3 + КоличествоРецептур;
	
	БазоваяШирина = 10;
	ТабДокумент.Область(1, 1).ШиринаКолонки = БазоваяШирина * 4;
	ТабДокумент.Область(1, 2).ШиринаКолонки = БазоваяШирина;
	ТабДокумент.Область(1, 3).ШиринаКолонки = БазоваяШирина;
	Для к = 4 По ПоследняяКолонка Цикл
		ТабДокумент.Область(1, к).ШиринаКолонки = БазоваяШирина * 2;
	КонецЦикла;
	
	// ===== ШАПКА =====
	МелкийЖирныйШрифт = Новый Шрифт(, 7, Истина);
	
	Область = ТабДокумент.Область(1, 1);
	Область.Текст = "Компонент";
	Область.Шрифт = МелкийЖирныйШрифт;
	Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	
	Область = ТабДокумент.Область(1, 2);
	Область.Текст = "Цена";
	Область.Шрифт = МелкийЖирныйШрифт;
	Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	
	Область = ТабДокумент.Область(1, 3);
	Область.Текст = "Остаток";
	Область.Шрифт = МелкийЖирныйШрифт;
	Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	
	Колонка = 4;
	Для Каждого СсылкаРецепта Из ПорядокРецептур Цикл
		Область = ТабДокумент.Область(1, Колонка);
		НаименованиеРецепта = Рецептуры[СсылкаРецепта];
		
		ЦветРецепта = ПолучитьЦветИзТекста(НаименованиеРецепта);
		ОтображаемоеИмя = УбратьЦветИзТекста(НаименованиеРецепта);
		
		Область.Текст = ОтображаемоеИмя;
		Область.Шрифт = МелкийЖирныйШрифт;
		Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		
		Если ЦветРецепта <> Неопределено Тогда
			Область.ЦветФона = ЦветРецепта;
		КонецЕсли;
		
		Колонка = Колонка + 1;
	КонецЦикла;
	
	// ===== СТРОКИ КОМПОНЕНТОВ =====
	Строка = 2;
	МассивСтрокТары = Новый Массив;
	
	ИтогоВес = Новый Соответствие;
	ИтогоСтоимость = Новый Соответствие;
	Для Каждого СсылкаРецепта Из ПорядокРецептур Цикл
		ИтогоВес.Вставить(СсылкаРецепта, 0);
		ИтогоСтоимость.Вставить(СсылкаРецепта, 0);
	КонецЦикла;
	
	Для Каждого Материал Из ПорядокКомпонентов Цикл
		
		Если Материал = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если Материал.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		
		Если Материал.ЭтоГруппа Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаКомпонента = Компоненты.Получить(Материал);
		Если СтрокаКомпонента = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТабДокумент.Область(Строка, 1).Текст = Материал.Наименование;
		
		Цена = ЦеныМатериалов.Получить(Материал);
		Если Цена = Неопределено Тогда
			Цена = 0;
		КонецЕсли;
		ТабДокумент.Область(Строка, 2).Текст = Цена;
		
		Остаток = ОстаткиМатериалов.Получить(Материал);
		Если Остаток = Неопределено Тогда
			Остаток = 0;
		КонецЕсли;
		ТабДокумент.Область(Строка, 3).Текст = Остаток;
		
		ЕдИзм = ЕдиницыМатериалов.Получить(Материал);
		ЭтоТара = (ЕдИзм = Перечисления.ЕдиницыИзмерения.Штука);
		
		Если ЭтоТара Тогда
			МассивСтрокТары.Добавить(XMLСтрока(Строка));
			ОбластьСтроки = ТабДокумент.Область(Строка, 1, Строка, ПоследняяКолонка);
			ОбластьСтроки.ЦветТекста = Новый Цвет(255, 0, 0);
		КонецЕсли;
		
		Колонка = 4;
		Для Каждого СсылкаРецепта Из ПорядокРецептур Цикл
			Значение = СтрокаКомпонента.Получить(СсылкаРецепта);
			Если Значение = Неопределено Тогда
				Значение = 0;
			КонецЕсли;
			ТабДокумент.Область(Строка, Колонка).Текст = Значение;
			
			Если Не ЭтоТара Тогда
				ИтогоВес[СсылкаРецепта] = ИтогоВес[СсылкаРецепта] + Значение;
			КонецЕсли;
			ИтогоСтоимость[СсылкаРецепта] = ИтогоСтоимость[СсылкаРецепта] + Значение * Цена;
			
			Колонка = Колонка + 1;
		КонецЦикла;
		
		ОбластьСтроки = ТабДокумент.Область(Строка, 1, Строка, ПоследняяКолонка);
		Если Остаток = 0 Тогда
			ОбластьСтроки.ЦветФона = Новый Цвет(255, 248, 220);
		ИначеЕсли Не ЭтоТара И Строка % 2 = 0 Тогда
			ОбластьСтроки.ЦветФона = Новый Цвет(242, 242, 242);
		КонецЕсли;
		
		Строка = Строка + 1;
		
	КонецЦикла;
	
	СтрокиТары = СтрСоединить(МассивСтрокТары, ",");
	
	// ===== СТРОКА "ПЕРЕРАБОТКА, РУБ" =====
	СтрокаПереработки = Строка;
	
	ТабДокумент.Область(СтрокаПереработки, 1).Текст = "Переработка, руб";
	
	Колонка = 4;
	Для Каждого СсылкаРецепта Из ПорядокРецептур Цикл
		ЗначениеПереработки = ПереработкаРецептур.Получить(СсылкаРецепта);
		Если ЗначениеПереработки = Неопределено Тогда
			ЗначениеПереработки = 0;
		КонецЕсли;
		ТабДокумент.Область(СтрокаПереработки, Колонка).Текст = ЗначениеПереработки;
		ИтогоСтоимость[СсылкаРецепта] = ИтогоСтоимость[СсылкаРецепта] + ЗначениеПереработки;
		Колонка = Колонка + 1;
	КонецЦикла;
	
	Если СтрокаПереработки % 2 = 0 Тогда
		ОбластьСтроки = ТабДокумент.Область(СтрокаПереработки, 1, СтрокаПереработки, ПоследняяКолонка);
		ОбластьСтроки.ЦветФона = Новый Цвет(242, 242, 242);
	КонецЕсли;
	
	Строка = СтрокаПереработки + 1;
	
	// ===== СТРОКА "ВСЕГО, КГ" =====
	ЖирныйШрифт = Новый Шрифт(,, Истина);
	СтрокаВсего = Строка;
	
	Яч = ТабДокумент.Область(СтрокаВсего, 1);
	Яч.Текст = "Всего, кг";
	Яч.Шрифт = ЖирныйШрифт;
	
	Колонка = 4;
	Для Каждого СсылкаРецепта Из ПорядокРецептур Цикл
		Яч = ТабДокумент.Область(СтрокаВсего, Колонка);
		Яч.Текст = ИтогоВес[СсылкаРецепта];
		Яч.Шрифт = ЖирныйШрифт;
		Колонка = Колонка + 1;
	КонецЦикла;
	
	// ===== СТРОКА "СТОИМОСТЬ, РУБ/КГ" =====
	СтрокаСтоимости = СтрокаВсего + 1;
	
	Яч = ТабДокумент.Область(СтрокаСтоимости, 1);
	Яч.Текст = "Стоимость, руб/кг";
	Яч.Шрифт = ЖирныйШрифт;
	
	Колонка = 4;
	Для Каждого СсылкаРецепта Из ПорядокРецептур Цикл
		Вес = ИтогоВес[СсылкаРецепта];
		Если Вес <> 0 Тогда
			Стоимость = Окр(ИтогоСтоимость[СсылкаРецепта] / Вес, 2);
		Иначе
			Стоимость = 0;
		КонецЕсли;
		Яч = ТабДокумент.Область(СтрокаСтоимости, Колонка);
		Яч.Текст = Стоимость;
		Яч.Шрифт = ЖирныйШрифт;
		Колонка = Колонка + 1;
	КонецЦикла;
	
	// ===== СЕТКА =====
	Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
	Для СтрИнд = 1 По СтрокаСтоимости Цикл
		Для КолИнд = 1 По ПоследняяКолонка Цикл
			Яч = ТабДокумент.Область(СтрИнд, КолИнд, СтрИнд, КолИнд);
			Яч.ГраницаСлева = Линия;
			Яч.ГраницаСправа = Линия;
			Яч.ГраницаСверху = Линия;
			Яч.ГраницаСнизу = Линия;
		КонецЦикла;
	КонецЦикла;
	
	ПоследняяКолонкаРецептур = ПоследняяКолонка;
	КолонкаКлона = 0;
	
КонецПроцедуры

&НаСервере
Процедура КлонироватьКолонкуНаСервере(НомерКолонкиИсточника)
	
	КолонкаРазделитель = ПоследняяКолонкаРецептур + 1;
	КолонкаЦель = ПоследняяКолонкаРецептур + 2;
	
	ТабДокумент.Область(1, КолонкаРазделитель).ШиринаКолонки = 2;
	
	БазоваяШирина = 10;
	ТабДокумент.Область(1, КолонкаЦель).ШиринаКолонки = БазоваяШирина * 2;
	
	ТекстИсточника = ТабДокумент.Область(1, НомерКолонкиИсточника).Текст;
	Область = ТабДокумент.Область(1, КолонкаЦель);
	Область.Текст = ТекстИсточника + " клон";
	Область.Шрифт = Новый Шрифт(, 7, Истина);
	Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	
	Для СтрНом = 2 По СтрокаВсего - 1 Цикл
		ЯчИсточник = ТабДокумент.Область(СтрНом, 1);
		ЯчЦель = ТабДокумент.Область(СтрНом, КолонкаЦель);
		ЯчЦель.Текст = ТабДокумент.Область(СтрНом, НомерКолонкиИсточника).Текст;
		Если ЯчИсточник.ЦветТекста <> Неопределено И ЯчИсточник.ЦветТекста <> Новый Цвет Тогда
			ЯчЦель.ЦветТекста = ЯчИсточник.ЦветТекста;
		КонецЕсли;
		Если ЯчИсточник.ЦветФона <> Неопределено И ЯчИсточник.ЦветФона <> Новый Цвет Тогда
			ЯчЦель.ЦветФона = ЯчИсточник.ЦветФона;
		КонецЕсли;
	КонецЦикла;
	
	// ===== ИТОГИ КЛОНА =====
	СтрокаСтоимости = СтрокаВсего + 1;
	
	ВесКлона = 0;
	СтоимостьКлона = 0;
	
	СоответствиеТары = Новый Соответствие;
	Если Не ПустаяСтрока(СтрокиТары) Тогда
		Для Каждого СтрНомТары Из СтрРазделить(СтрокиТары, ",") Цикл
			СоответствиеТары.Вставить(Число(СтрНомТары), Истина);
		КонецЦикла;
	КонецЕсли;
	
	Для СтрНом = 2 По СтрокаВсего - 2 Цикл
		ЗначениеКлона = ТекстВЧисло(ТабДокумент.Область(СтрНом, КолонкаЦель).Текст);
		Цена = ТекстВЧисло(ТабДокумент.Область(СтрНом, 2).Текст);
		
		Если СоответствиеТары.Получить(СтрНом) = Неопределено Тогда
			ВесКлона = ВесКлона + ЗначениеКлона;
		КонецЕсли;
		СтоимостьКлона = СтоимостьКлона + ЗначениеКлона * Цена;
	КонецЦикла;
	
	ПереработкаКлона = ТекстВЧисло(ТабДокумент.Область(СтрокаВсего - 1, КолонкаЦель).Текст);
	СтоимостьКлона = СтоимостьКлона + ПереработкаКлона;
	
	ЖирныйШрифт = Новый Шрифт(,, Истина);
	
	Яч = ТабДокумент.Область(СтрокаВсего, КолонкаЦель);
	Яч.Текст = ВесКлона;
	Яч.Шрифт = ЖирныйШрифт;
	
	Яч = ТабДокумент.Область(СтрокаСтоимости, КолонкаЦель);
	Если ВесКлона <> 0 Тогда
		Яч.Текст = Окр(СтоимостьКлона / ВесКлона, 2);
	Иначе
		Яч.Текст = 0;
	КонецЕсли;
	Яч.Шрифт = ЖирныйШрифт;
	
	// ===== РАМКИ КЛОНА =====
	Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
	Для СтрНом = 1 По СтрокаСтоимости Цикл
		Яч = ТабДокумент.Область(СтрНом, КолонкаЦель, СтрНом, КолонкаЦель);
		Яч.ГраницаСлева = Линия;
		Яч.ГраницаСправа = Линия;
		Яч.ГраницаСверху = Линия;
		Яч.ГраницаСнизу = Линия;
	КонецЦикла;
	
	КолонкаКлона = КолонкаЦель;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьИтогиКлона()
	ВесКлона = 0;
	СтоимостьКлона = 0;
	
	СоответствиеТары = Новый Соответствие;
	Если Не ПустаяСтрока(СтрокиТары) Тогда
		Для Каждого СтрНомТары Из СтрРазделить(СтрокиТары, ",") Цикл
			Попытка
				СоответствиеТары.Вставить(Число(СтрНомТары), Истина);
			Исключение
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	
	Для СтрНом = 2 По СтрокаВсего - 2 Цикл
		ЗначениеКлона = ТекстВЧисло(ТабДокумент.Область(СтрНом, КолонкаКлона).Текст);
		Цена = ТекстВЧисло(ТабДокумент.Область(СтрНом, 2).Текст);
		
		Если СоответствиеТары.Получить(СтрНом) = Неопределено Тогда
			ВесКлона = ВесКлона + ЗначениеКлона;
		КонецЕсли;
		СтоимостьКлона = СтоимостьКлона + ЗначениеКлона * Цена;
	КонецЦикла;
	
	ПереработкаКлона = ТекстВЧисло(ТабДокумент.Область(СтрокаВсего - 1, КолонкаКлона).Текст);
	СтоимостьКлона = СтоимостьКлона + ПереработкаКлона;
	
	ТабДокумент.Область(СтрокаВсего, КолонкаКлона).Текст = ВесКлона;
	
	Если ВесКлона <> 0 Тогда
		ТабДокумент.Область(СтрокаВсего + 1, КолонкаКлона).Текст = Окр(СтоимостьКлона / ВесКлона, 2);
	Иначе
		ТабДокумент.Область(СтрокаВсего + 1, КолонкаКлона).Текст = 0;
	КонецЕсли;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ТекстВЧисло(Текст)
	Попытка
		Возврат Число(СтрЗаменить(СтрЗаменить(Текст, Символ(160), ""), " ", ""));
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

&НаСервере
Функция ПолучитьЦветИзТекста(Текст)
	Позиция = СтрНайти(Текст, "#");
	Если Позиция = 0 Или (СтрДлина(Текст) - Позиция) < 6 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КодЦвета = Сред(Текст, Позиция + 1, 6);
	
	R = ГексВДесятичное(Сред(КодЦвета, 1, 2));
	G = ГексВДесятичное(Сред(КодЦвета, 3, 2));
	B = ГексВДесятичное(Сред(КодЦвета, 5, 2));
	
	Если R < 0 Или G < 0 Или B < 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если R = 0 И G = 0 И B = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Новый Цвет(R, G, B);
КонецФункции

&НаСервере
Функция УбратьЦветИзТекста(Текст)
	Позиция = СтрНайти(Текст, "#");
	Если Позиция = 0 Или (СтрДлина(Текст) - Позиция) < 6 Тогда
		Возврат Текст;
	КонецЕсли;
	
	КодЦвета = Сред(Текст, Позиция + 1, 6);
	Если ГексВДесятичное(Сред(КодЦвета, 1, 2)) < 0
		Или ГексВДесятичное(Сред(КодЦвета, 3, 2)) < 0
		Или ГексВДесятичное(Сред(КодЦвета, 5, 2)) < 0 Тогда
		Возврат Текст;
	КонецЕсли;
	
	Возврат СокрЛП(Лев(Текст, Позиция - 1) + Сред(Текст, Позиция + 7));
КонецФункции

&НаСервере
Функция ГексВДесятичное(СтрГекс)
	Результат = 0;
	Для Инд = 1 По СтрДлина(СтрГекс) Цикл
		Симв = ВРег(Сред(СтрГекс, Инд, 1));
		Код = КодСимвола(Симв);
		Если Код >= КодСимвола("0") И Код <= КодСимвола("9") Тогда
			Цифра = Код - КодСимвола("0");
		ИначеЕсли Код >= КодСимвола("A") И Код <= КодСимвола("F") Тогда
			Цифра = Код - КодСимвола("A") + 10;
		Иначе
			Возврат -1;
		КонецЕсли;
		Результат = Результат * 16 + Цифра;
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти