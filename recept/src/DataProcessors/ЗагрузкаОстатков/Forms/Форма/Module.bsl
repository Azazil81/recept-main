#Область Удаление

&НаСервере
Функция ОчиститьОстаткиПоПродукцииНаСервере()
	
	СчетчикСтрок = 0;
	
	// 1. Ищем папку Продукция в правильном справочнике
	ПапкаПродукция = Справочники.НоменклатураМатериалы.НайтиПоНаименованию("Продукция", Истина);
	
	Если ПапкаПродукция.Пустая() Тогда
		Сообщить("Папка 'Продукция' не найдена. Подготовка документа невозможна.");
		Возврат 0;
	КонецЕсли;

	// 2. Получаем текущие остатки по регистру
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОстаткиМатериаловОстатки.Наименование КАК НоменклатураСсылка,
		|	ОстаткиМатериаловОстатки.ОстатокОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.ОстаткиМатериалов.Остатки(, Наименование В ИЕРАРХИИ (&ПапкаПродукция)) КАК ОстаткиМатериаловОстатки";
	
	Запрос.УстановитьПараметр("ПапкаПродукция", ПапкаПродукция);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Сообщить("Остатков по папке 'Продукция' не обнаружено.");
		Возврат 0;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();

	// 3. Создаем объект документа (но не проводим его)
	ДокОбъект = Документы.КоррекцияОстатков.СоздатьДокумент();
	ДокОбъект.Дата = ТекущаяДата();
	ДокОбъект.Комментарий = "Заполнение остатками из папки Продукция для последующей очистки";
	
	// 4. Заполняем ТАБЛИЧНУЮ ЧАСТЬ "Материалы"
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ДокОбъект.Материалы.Добавить();
		
		// Заполняем только номенклатуру (из измерения Наименование)
		НоваяСтрока.Номенклатура = Выборка.НоменклатураСсылка;
		НоваяСтрока.Коррекция = - Выборка.Количество;
		// Обычно для коррекции нужно и количество, чтобы понимать, что списывать
		//Если ОбщегоНазначения.ЕстьРеквизитТабличнойЧастиДокумента("Количество", "Материалы", Метаданные.Документы.КоррекцияОстатков) Тогда
		//	НоваяСтрока.Количество = Выборка.Количество;
		//КонецЕсли;
		
		СчетчикСтрок = СчетчикСтрок + 1;
		
	КонецЦикла;

	// 5. Записываем документ БЕЗ ПРОВЕДЕНИЯ
	Попытка
		// РежимЗаписиДокумента.Запись — это просто сохранение черновика
		ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		Сообщить("Создан черновик документа: " + Строка(ДокОбъект.Ссылка));
	Исключение
		Сообщить("Не удалось записать документ: " + ОписаниеОшибки());
		Возврат 0;
	КонецПопытки;

	Возврат СчетчикСтрок;

КонецФункции

&НаКлиенте
Процедура ОчиститьОстаткиПоПродукции(Команда)
	ОчиститьОстаткиПоПродукцииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура УдалениеПродукцииВАрхив(Команда)
	ТекстВопроса = "ВНИМАНИЕ! Вся номенклатура будет перемещена в папку ""Архив"" и помечена на удаление. Продолжить?";
	
	Оповещение = Новый ОписаниеОповещения("ПереместитьВсеВАрхивЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
КонецПроцедуры

&НаКлиенте
Процедура ПереместитьВсеВАрхивЗавершение(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ОбработанноеКоличество = ПереместитьИзПродукцииВАрхивНаСервере();
		ПоказатьОповещениеПользователя("Готово", , "Перемещено и помечено элементов: " + Строка(ОбработанноеКоличество));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПереместитьИзПродукцииВАрхивНаСервере()
	
	Счетчик = 0;
	
	// 1. Получаем ссылку на предопределенную папку Архив
	ПапкаАрхив = Справочники.НоменклатураМатериалы.Архив;
	
	// 2. Ищем папку Продукция
	ПапкаПродукция = Справочники.НоменклатураМатериалы.НайтиПоНаименованию("Продукция", Истина);
	
	Если ПапкаПродукция.Пустая() Тогда
		Сообщить("Папка 'Продукция' не найдена в справочнике!");
		Возврат 0;
	КонецЕсли;
	
	// 3. Выбираем все элементы, которые находятся ВНУТРИ Продукции
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НоменклатураМатериалы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.НоменклатураМатериалы КАК НоменклатураМатериалы
		|ГДЕ
		|	НоменклатураМатериалы.ЭтоГруппа = ЛОЖЬ
		|	И НоменклатураМатериалы.Родитель В ИЕРАРХИИ(&ПапкаПродукция)";
		
	Запрос.УстановитьПараметр("ПапкаПродукция", ПапкаПродукция);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	НачатьТранзакцию();
	Попытка
		Пока Выборка.Следующий() Цикл
			
			ОбъектНоменклатуры = Выборка.Ссылка.ПолучитьОбъект();
			
			// Устанавливаем нового родителя и пометку
			ОбъектНоменклатуры.Родитель = ПапкаАрхив;
			ОбъектНоменклатуры.ПометкаУдаления = Истина;
			
			// Записываем без проверок (РежимЗаписи.Запись), чтобы обойти возможные блокировки логики
			ОбъектНоменклатуры.Записать();
			Счетчик = Счетчик + 1;
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Сообщить("Произошла ошибка: " + ОписаниеОшибки());
		Возврат 0;
	КонецПопытки;
	
	Возврат Счетчик;
	
КонецФункции

#КонецОбласти





#Область СозданиеСправочников

&НаСервере
Процедура СинхронизироватьНСИНаСервере()  
	
    ПапкаПродукция = Справочники.НоменклатураМатериалы.Продукция;
    ЕдиницаКГ = Перечисления.ЕдиницыИзмерения.Килограмм;
    
    // В кэше будем хранить ссылки и для товаров, и для комплектов
    КэшНоменклатуры = Новый Соответствие;
    
    НачатьТранзакцию();
    
    Попытка
        Для Каждого Стр Из Реквизит1 Цикл  
            
            НаименованиеБазовое = СокрЛП(Стр.Номенклатура);
            Если ПустаяСтрока(НаименованиеБазовое) Тогда Продолжить; КонецЕсли;

            // 1. ПОЛУЧАЕМ БАЗОВЫЙ ТОВАР
            СсылкаНаТовар = КэшНоменклатуры.Получить(НаименованиеБазовое);
            Если СсылкаНаТовар = Неопределено Тогда
                СсылкаНаТовар = Справочники.НоменклатураМатериалы.НайтиПоНаименованию(НаименованиеБазовое, Истина, ПапкаПродукция);
                Если СсылкаНаТовар.Пустая() Тогда
                    НовЭлемент = Справочники.НоменклатураМатериалы.СоздатьЭлемент();
                    НовЭлемент.Наименование          = НаименованиеБазовое;
                    НовЭлемент.Родитель              = ПапкаПродукция;
                    НовЭлемент.ЕдиницаИзмеренияСырья  = ЕдиницаКГ;
                    НовЭлемент.ТипНоменклатуры       = Перечисления.ТипыНоменклатуры.Продукция;
                    НовЭлемент.Записать();
                    СсылкаНаТовар = НовЭлемент.Ссылка;
                КонецЕсли;
                КэшНоменклатуры.Вставить(НаименованиеБазовое, СсылкаНаТовар);
            КонецЕсли;

            // 2. ОПРЕДЕЛЯЕМ ЦЕЛЕВУЮ НОМЕНКЛАТУРУ (Товар или Комплект)
            ЦелеваяНоменклатура = СсылкаНаТовар; // По умолчанию товар

            Если Стр.Комплект = Истина Тогда
                ИмяКомплекта = НаименованиеБазовое + " (к-кт)";
                СсылкаНаКомплект = КэшНоменклатуры.Получить(ИмяКомплекта);
                
                Если СсылкаНаКомплект = Неопределено Тогда
                    СсылкаНаКомплект = Справочники.НоменклатураМатериалы.НайтиПоНаименованию(ИмяКомплекта, Истина, ПапкаПродукция);
                    Если СсылкаНаКомплект.Пустая() Тогда
                        НовКомплект = Справочники.НоменклатураМатериалы.СоздатьЭлемент();
                        НовКомплект.Наименование    = ИмяКомплекта;
                        НовКомплект.Родитель        = ПапкаПродукция;
                        НовКомплект.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Комплект;
                        НовКомплект.Записать();
                        СсылкаНаКомплект = НовКомплект.Ссылка;
                    КонецЕсли;
                    КэшНоменклатуры.Вставить(ИмяКомплекта, СсылкаНаКомплект);
                КонецЕсли;
                
                ЦелеваяНоменклатура = СсылкаНаКомплект;
            КонецЕсли;

            // 3. ПРИВЯЗЫВАЕМ ССЫЛКИ
            // Теперь ЦелеваяНоменклатура — это либо Товар, либо Комплект в зависимости от галочки
            Стр.СсылкаНоменклатура   = ЦелеваяНоменклатура;
            Стр.СсылкаХарактеристика = СоздатьИлиНайтиХарактеристику(ЦелеваяНоменклатура, Стр);
            Стр.СсылкаПартия = СоздатьИлиНайтиПартию(Стр.СсылкаХарактеристика, Стр);
            
        КонецЦикла;
        
        ЗафиксироватьТранзакцию();
        Сообщить("Синхронизация завершена.");

    Исключение
        ОтменитьТранзакцию();
        Сообщить("Ошибка: " + ОписаниеОшибки());
    КонецПопытки;
	
КонецПроцедуры   


// Вспомогательная функция, чтобы не дублировать код для товара и комплекта
&НаСервере
Функция СоздатьИлиНайтиХарактеристику(ВладелецСсылка, ДанныеСтроки)

	
	// 1. Получаем базовые данные
	//ИмяНоменклатуры      = ВладелецСсылка.Наименование;
	ЦветНаименование     = СокрЛП(ДанныеСтроки.Цвет);
	УпаковкаНаименование = СокрЛП(ДанныеСтроки.Фасовка);
	
	// Очистка RAL от любых пробелов
	РАЛНаименование = Строка(ДанныеСтроки.RAL); // Принудительно в строку
	РАЛНаименование = СтрЗаменить(РАЛНаименование, " ", "");          // Убираем обычный пробел
	РАЛНаименование = СтрЗаменить(РАЛНаименование, Символы.НПП, ""); // Убираем неразрывный пробел
	РАЛНаименование = СокрЛП(РАЛНаименование);	
	
	// 2. Собираем наименование по новому шаблону
	// Шаблон: [Имя] [Цвет] RAL [РАЛ] ([Фасовка])
	
	РезультатИмя = "";
	
	Если ЗначениеЗаполнено(ЦветНаименование) Тогда
		РезультатИмя = РезультатИмя + " " + ЦветНаименование;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РАЛНаименование) Тогда
		РезультатИмя = РезультатИмя + " RAL " + РАЛНаименование;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(УпаковкаНаименование) Тогда
		РезультатИмя = РезультатИмя + " (" + УпаковкаНаименование + ")";
	КонецЕсли;
	
	НаименованиеХар = СокрЛП(РезультатИмя);
	
	Если ПустаяСтрока(НаименованиеХар) Тогда
		Возврат Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	КонецЕсли;
	
	// 3. Поиск существующей характеристики (через запрос для точности)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ Ссылка ИЗ Справочник.ХарактеристикиНоменклатуры 
	|ГДЕ Владелец = &Владелец И Наименование = &Наименование";
	Запрос.УстановитьПараметр("Владелец",    ВладелецСсылка);
	Запрос.УстановитьПараметр("Наименование", НаименованиеХар);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	// 4. Создание новой, если не нашли
	ОбъектХар = Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент();
	ОбъектХар.Владелец     = ВладелецСсылка;
	ОбъектХар.Наименование = НаименованиеХар;
	
	// Заполнение дополнительных реквизитов (используем ранее созданную функцию)
	Если ЗначениеЗаполнено(ЦветНаименование) Тогда
		ОбъектХар.Цвет = ПолучитьИлиСоздатьЭлементСправочника(Справочники.Цвет, ЦветНаименование);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РАЛНаименование) Тогда
		ОбъектХар.RAL = ПолучитьИлиСоздатьЭлементСправочника(Справочники.RAL, РАЛНаименование);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(УпаковкаНаименование) Тогда
		ОбъектХар.Фасовка = ПолучитьИлиСоздатьЭлементСправочника(Справочники.Фасовка, УпаковкаНаименование);
	КонецЕсли;
	
	Попытка
		ОбъектХар.Записать();
		Возврат ОбъектХар.Ссылка;
	Исключение
		Сообщить("Ошибка записи характеристики: " + ОписаниеОшибки());
		Возврат Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	КонецПопытки;
	
КонецФункции  

&НаСервере
Функция СоздатьИлиНайтиПартию(ВладелецХарактеристика, ДанныеСтроки)
	
	// Если характеристика пустая, то и партию создать не получится (нет владельца)
	Если ВладелецХарактеристика.Пустая() Тогда
		Возврат Справочники.Партии.ПустаяСсылка();
	КонецЕсли;
	
	НаименованиеПартии = СокрЛП(Строка(ДанныеСтроки.Партия));
	
	Если ПустаяСтрока(НаименованиеПартии) Тогда
		Возврат Справочники.Партии.ПустаяСсылка();
	КонецЕсли;
	
	// 1. Поиск существующей партии по владельцу-характеристике
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ Ссылка ИЗ Справочник.Партии 
		|ГДЕ Владелец = &Владелец И Наименование = &Наименование";
	Запрос.УстановитьПараметр("Владелец", ВладелецХарактеристика);
	Запрос.УстановитьПараметр("Наименование", НаименованиеПартии);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	// 2. Создание новой партии
	ОбъектПартии = Справочники.Партии.СоздатьЭлемент();
	ОбъектПартии.Владелец = ВладелецХарактеристика; // Теперь владелец — Характеристика
	ОбъектПартии.Наименование = НаименованиеПартии;
	
	// 3. Обработка реквизита "ВходнойКонтроль" (Булево)
	ЗначениеВК = НРег(СокрЛП(Строка(ДанныеСтроки.ВходнойКонтроль)));
	Если ЗначениеВК = "да" Или ЗначениеВК = "истина" Или ЗначениеВК = "true" Или ЗначениеВК = "1" Тогда
		ОбъектПартии.ВходнойКонтроль = Истина;
	Иначе
		ОбъектПартии.ВходнойКонтроль = Ложь;
	КонецЕсли;
	
	// 4. Обработка реквизита "Брак" (Перечисление)
	ЗначениеБрак = НРег(СокрЛП(Строка(ДанныеСтроки.Брак)));
	
	// ВНИМАНИЕ: Проверьте имена значений перечисления Брак в вашей базе
	Если ЗначениеБрак = "да" Или ЗначениеБрак = "брак" Тогда
		ОбъектПартии.Брак = Перечисления.Брак.Брак; 
	КонецЕсли;
	
	Попытка
		ОбъектПартии.Записать();
		Возврат ОбъектПартии.Ссылка;
	Исключение
		Сообщить("Ошибка записи партии '" + НаименованиеПартии + "': " + ОписаниеОшибки());
		Возврат Справочники.Партии.ПустаяСсылка();
	КонецПопытки;
КонецФункции

// Универсальная функция-помощник для поиска и создания элементов простых справочников
&НаСервере
Функция ПолучитьИлиСоздатьЭлементСправочника(МенеджерСправочника, НаименованиеЭлемента)
	
	Если ПустаяСтрока(НаименованиеЭлемента) Тогда
		Возврат МенеджерСправочника.ПустаяСсылка();
	КонецЕсли;
	
	СсылкаНаЭлемент = МенеджерСправочника.НайтиПоНаименованию(НаименованиеЭлемента, Истина);
	
	Если СсылкаНаЭлемент.Пустая() Тогда
		Попытка
			НовыйЭлемент = МенеджерСправочника.СоздатьЭлемент();
			НовыйЭлемент.Наименование = НаименованиеЭлемента;
			НовыйЭлемент.Записать();
			Возврат НовыйЭлемент.Ссылка;
		Исключение
			Сообщить("Ошибка при создании элемента '" + НаименованиеЭлемента + "': " + ОписаниеОшибки());
			Возврат МенеджерСправочника.ПустаяСсылка();
		КонецПопытки;
	КонецЕсли;
	
	Возврат СсылкаНаЭлемент;
	
КонецФункции


&НаКлиенте
Процедура СинхронизацияИСозданиеСправочников(Команда)
	СинхронизироватьНСИНаСервере();
	ПоказатьОповещениеПользователя("Готово", , "Синхронизация справочников завершена");
КонецПроцедуры

#КонецОбласти





#Область СозданиеДокументов



&НаСервере
Функция СоздатьДокументыНаСервере()
	
	// 1. Проверка на заполненность обязательных данных
	Ошибок = 0;
	Для Каждого Стр Из Объект.ТаблицаЗагрузки Цикл
		Если Не ЗначениеЗаполнено(Стр.ТоварСсылка) Тогда
			Сообщить("В строке " + Стр.НомерСтроки + " не заполнена Номенклатура!");
			Ошибок = Ошибок + 1;
		КонецЕсли;
		// Если для товара обязательна партия, добавьте проверку здесь
	КонецЦикла;
	
	Если Ошибок > 0 Тогда
		Возврат Неопределено; // Прерываем создание документа
	КонецЕсли;
	
	// 2. Выгружаем данные с формы в серверную Таблицу Значений для свертки
	ТЗ = Объект.ТаблицаЗагрузки.Выгрузить();
	
	// Оставляем только нужные колонки
	ТЗ.Очистить(); // Нам нужны только данные, структуру оставляем
	ТЗ = Объект.ТаблицаЗагрузки.Выгрузить( , "ТоварСсылка, ХарСсылка, ПартияСсылка, МестоХраненияСсылка, Количество");
	
	// 3. Свертка (суммируем количество по одинаковым аналитикам)
	ТЗ.Свернуть("ТоварСсылка, ХарСсылка, ПартияСсылка, МестоХраненияСсылка", "Количество");
	
	// 4. Создание документа
	ДокОбъект = Документы.ВводНачальныхОстатков.СоздатьДокумент();
	ДокОбъект.Дата = ТекущаяДата();
	// ДокОбъект.Организация = ... (укажите организацию, если требуется)
	
	Для Каждого СтрТЗ Из ТЗ Цикл
		НовСтрока = ДокОбъект.Товары.Добавить();
		НовСтрока.Номенклатура = СтрТЗ.ТоварСсылка;
		НовСтрока.Характеристика = СтрТЗ.ХарСсылка;
		НовСтрока.Партия = СтрТЗ.ПартияСсылка;
		// Если склад указывается в ТЧ:
		// НовСтрока.Склад = СтрТЗ.МестоХраненияСсылка; 
		НовСтрока.Количество = СтрТЗ.Количество;
	КонецЦикла;
	
	Попытка
		// Записываем документ и пытаемся провести
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Возврат ДокОбъект.Ссылка;
	Исключение
		Сообщить("Не удалось провести документ: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Процедура СоздатьДокументОстатков(Команда)
	
	Рез = СоздатьДокументыНаСервере();
	Если ЗначениеЗаполнено(Рез) Тогда
		ПоказатьОповещениеПользователя("Успех", , "Создан документ: " + Строка(Рез));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ВыполнитьЗагрузку(Команда)
	
	Путь = Объект.ФайлЗагрузки;

    Если Путь = "" Тогда
        Сообщить("Укажите путь к файлу Excel.");
        Возврат;
    КонецЕсли;
    
    Попытка
        // Очищаем существующую таблицу значений
        Реквизит1.Очистить();
        
        // Подключаем Excel
        ExcelApp = Новый COMОбъект("Excel.Application");
        ExcelApp.Visible = Ложь;
        Книга = ExcelApp.Workbooks.Open(Путь);
        Лист = Книга.Worksheets(1);
        
        Строк = Лист.UsedRange.Rows.Count;
        
        Для i = 2 По Строк Цикл // первая строка - заголовки
            НоваяСтрока =         Реквизит1.Добавить();
            
            НоваяСтрока.Номенклатура 	= Лист.Cells(i,1).Value;
            НоваяСтрока.Цвет 			= Лист.Cells(i,2).Value;
            НоваяСтрока.ral 			= Лист.Cells(i,3).Value;
            НоваяСтрока.Партия 			= Лист.Cells(i,4).Value;
            НоваяСтрока.Количество 		= Лист.Cells(i,5).Value;
            //НоваяСтрока.Комплект 		= Лист.Cells(i,6).Value;
            НоваяСтрока.Фасовка 		= Лист.Cells(i,7).Value;
			//НоваяСтрока.ВесОтвердителя 	= Лист.Cells(i,8).Value;
            НоваяСтрока.Брак			= Лист.Cells(i,9).Value; 
			НоваяСтрока.Примечание		= Лист.Cells(i,10).Value;
            НоваяСтрока.ВходнойКонтроль = Лист.Cells(i,11).Value;
            НоваяСтрока.Комплект 		= Лист.Cells(i,12).Value;
            НоваяСтрока.Счет			= Лист.Cells(i,13).Value;
            НоваяСтрока.МестоХранения 	= Лист.Cells(i,14).Value;
            НоваяСтрока.Контрагент		= Лист.Cells(i,15).Value;
            НоваяСтрока.Цена 			= Лист.Cells(i,16).Value;
                       
        КонецЦикла;
        
        Книга.Close(Ложь);
        ExcelApp.Quit();
        Книга = Неопределено;
		Лист = Неопределено;
		ExcelApp = Неопределено;
        
        Сообщить("Данные успешно загружены.");
        
    Исключение
        Сообщить("Ошибка при загрузке Excel: " + ОписаниеОшибки());
    КонецПопытки;

КонецПроцедуры
