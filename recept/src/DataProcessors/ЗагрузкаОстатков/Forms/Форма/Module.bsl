
&НаКлиенте
Процедура УдалениеПродукцииВАрхив(Команда)
	ТекстВопроса = "ВНИМАНИЕ! Вся номенклатура будет перемещена в папку ""Архив"" и помечена на удаление. Продолжить?";
	
	Оповещение = Новый ОписаниеОповещения("ПереместитьВсеВАрхивЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
КонецПроцедуры

&НаКлиенте
Процедура ПереместитьВсеВАрхивЗавершение(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ОбработанноеКоличество = ПереместитьИзПродукцииВАрхивНаСервере();
		ПоказатьОповещениеПользователя("Готово", , "Перемещено и помечено элементов: " + Строка(ОбработанноеКоличество));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПереместитьИзПродукцииВАрхивНаСервере()
	
	Счетчик = 0;
	
	// 1. Получаем ссылку на предопределенную папку Архив
	ПапкаАрхив = Справочники.НоменклатураМатериалы.Архив;
	
	// 2. Ищем папку Продукция
	ПапкаПродукция = Справочники.НоменклатураМатериалы.НайтиПоНаименованию("Продукция", Истина);
	
	Если ПапкаПродукция.Пустая() Тогда
		Сообщить("Папка 'Продукция' не найдена в справочнике!");
		Возврат 0;
	КонецЕсли;
	
	// 3. Выбираем все элементы, которые находятся ВНУТРИ Продукции
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НоменклатураМатериалы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.НоменклатураМатериалы КАК НоменклатураМатериалы
		|ГДЕ
		|	НоменклатураМатериалы.ЭтоГруппа = ЛОЖЬ
		|	И НоменклатураМатериалы.Родитель В ИЕРАРХИИ(&ПапкаПродукция)";
		
	Запрос.УстановитьПараметр("ПапкаПродукция", ПапкаПродукция);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	НачатьТранзакцию();
	Попытка
		Пока Выборка.Следующий() Цикл
			
			ОбъектНоменклатуры = Выборка.Ссылка.ПолучитьОбъект();
			
			// Устанавливаем нового родителя и пометку
			ОбъектНоменклатуры.Родитель = ПапкаАрхив;
			ОбъектНоменклатуры.ПометкаУдаления = Истина;
			
			// Записываем без проверок (РежимЗаписи.Запись), чтобы обойти возможные блокировки логики
			ОбъектНоменклатуры.Записать();
			Счетчик = Счетчик + 1;
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Сообщить("Произошла ошибка: " + ОписаниеОшибки());
		Возврат 0;
	КонецПопытки;
	
	Возврат Счетчик;
	
КонецФункции

&НаСервере
Функция СоздатьДокументыНаСервере()
	
	// 1. Проверка на заполненность обязательных данных
	Ошибок = 0;
	Для Каждого Стр Из Объект.ТаблицаЗагрузки Цикл
		Если Не ЗначениеЗаполнено(Стр.ТоварСсылка) Тогда
			Сообщить("В строке " + Стр.НомерСтроки + " не заполнена Номенклатура!");
			Ошибок = Ошибок + 1;
		КонецЕсли;
		// Если для товара обязательна партия, добавьте проверку здесь
	КонецЦикла;
	
	Если Ошибок > 0 Тогда
		Возврат Неопределено; // Прерываем создание документа
	КонецЕсли;
	
	// 2. Выгружаем данные с формы в серверную Таблицу Значений для свертки
	ТЗ = Объект.ТаблицаЗагрузки.Выгрузить();
	
	// Оставляем только нужные колонки
	ТЗ.Очистить(); // Нам нужны только данные, структуру оставляем
	ТЗ = Объект.ТаблицаЗагрузки.Выгрузить( , "ТоварСсылка, ХарСсылка, ПартияСсылка, МестоХраненияСсылка, Количество");
	
	// 3. Свертка (суммируем количество по одинаковым аналитикам)
	ТЗ.Свернуть("ТоварСсылка, ХарСсылка, ПартияСсылка, МестоХраненияСсылка", "Количество");
	
	// 4. Создание документа
	ДокОбъект = Документы.ВводНачальныхОстатков.СоздатьДокумент();
	ДокОбъект.Дата = ТекущаяДата();
	// ДокОбъект.Организация = ... (укажите организацию, если требуется)
	
	Для Каждого СтрТЗ Из ТЗ Цикл
		НовСтрока = ДокОбъект.Товары.Добавить();
		НовСтрока.Номенклатура = СтрТЗ.ТоварСсылка;
		НовСтрока.Характеристика = СтрТЗ.ХарСсылка;
		НовСтрока.Партия = СтрТЗ.ПартияСсылка;
		// Если склад указывается в ТЧ:
		// НовСтрока.Склад = СтрТЗ.МестоХраненияСсылка; 
		НовСтрока.Количество = СтрТЗ.Количество;
	КонецЦикла;
	
	Попытка
		// Записываем документ и пытаемся провести
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Возврат ДокОбъект.Ссылка;
	Исключение
		Сообщить("Не удалось провести документ: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Процедура СоздатьДокументОстатков(Команда)
	
	Рез = СоздатьДокументыНаСервере();
	Если ЗначениеЗаполнено(Рез) Тогда
		ПоказатьОповещениеПользователя("Успех", , "Создан документ: " + Строка(Рез));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СинхронизироватьНСИНаСервере()
	
	// Создаем кэш для ускорения работы и предотвращения поиска одного и того же в базе
	КэшНоменклатуры = Новый Соответствие;
	КэшХарактеристик = Новый Соответствие;
	КэшПартий = Новый Соответствие;
	
	НачатьТранзакцию();
	
	Попытка
		Для Каждого Стр Из Объект.ТаблицаЗагрузки Цикл
			
			// === 1. НОМЕНКЛАТУРА ===
			Если Не ЗначениеЗаполнено(Стр.ТоварСсылка) И ЗначениеЗаполнено(Стр.ТоварНаименование) Тогда
				НайденныйТовар = КэшНоменклатуры.Получить(Стр.ТоварНаименование);
				
				Если НайденныйТовар = Неопределено Тогда
					НайденныйТовар = Справочники.Номенклатура.НайтиПоНаименованию(Стр.ТоварНаименование);
					
					// Если в базе нет - создаем
					Если Не ЗначениеЗаполнено(НайденныйТовар) Тогда
						НовТовар = Справочники.Номенклатура.СоздатьЭлемент();
						НовТовар.Наименование = Стр.ТоварНаименование;
						// НовТовар.ВидНоменклатуры = ... (если требуется обязательное заполнение)
						НовТовар.Записать();
						НайденныйТовар = НовТовар.Ссылка;
					КонецЕсли;
					
					КэшНоменклатуры.Вставить(Стр.ТоварНаименование, НайденныйТовар);
				КонецЕсли;
				
				Стр.ТоварСсылка = НайденныйТовар;
			КонецЕсли;
			
			// === 2. ХАРАКТЕРИСТИКА ===
			// Создаем характеристику, только если есть владелец (Товар) и имя характеристики
			Если ЗначениеЗаполнено(Стр.ТоварСсылка) И Не ЗначениеЗаполнено(Стр.ХарСсылка) И ЗначениеЗаполнено(Стр.ХарНаименование) Тогда
				// Уникальный ключ кэша: ИД Товара + Имя Характеристики
				КлючХар = Строка(Стр.ТоварСсылка.УникальныйИдентификатор()) + "_" + Стр.ХарНаименование;
				НайденнаяХар = КэшХарактеристик.Получить(КлючХар);
				
				Если НайденнаяХар = Неопределено Тогда
					НайденнаяХар = Справочники.ХарактеристикиНоменклатуры.НайтиПоНаименованию(Стр.ХарНаименование, Истина, Стр.ТоварСсылка);
					
					Если Не ЗначениеЗаполнено(НайденнаяХар) Тогда
						НовХар = Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент();
						НовХар.Владелец = Стр.ТоварСсылка;
						НовХар.Наименование = Стр.ХарНаименование;
						НовХар.Записать();
						НайденнаяХар = НовХар.Ссылка;
					КонецЕсли;
					
					КэшХарактеристик.Вставить(КлючХар, НайденнаяХар);
				КонецЕсли;
				
				Стр.ХарСсылка = НайденнаяХар;
			КонецЕсли;
			
			// === 3. ПАРТИЯ ===
			Если ЗначениеЗаполнено(Стр.ТоварСсылка) И Не ЗначениеЗаполнено(Стр.ПартияСсылка) И ЗначениеЗаполнено(Стр.НомерПартии) Тогда
				КлючПартии = Строка(Стр.ТоварСсылка.УникальныйИдентификатор()) + "_" + Стр.НомерПартии;
				НайденнаяПартия = КэшПартий.Получить(КлючПартии);
				
				Если НайденнаяПартия = Неопределено Тогда
					НайденнаяПартия = Справочники.ПартииНоменклатуры.НайтиПоНаименованию(Стр.НомерПартии, Истина, Стр.ТоварСсылка);
					
					Если Не ЗначениеЗаполнено(НайденнаяПартия) Тогда
						НовПартия = Справочники.ПартииНоменклатуры.СоздатьЭлемент();
						НовПартия.Владелец = Стр.ТоварСсылка;
						НовПартия.Наименование = Стр.НомерПартии;
						НовПартия.Записать();
						НайденнаяПартия = НовПартия.Ссылка;
					КонецЕсли;
					
					КэшПартий.Вставить(КлючПартии, НайденнаяПартия);
				КонецЕсли;
				
				Стр.ПартияСсылка = НайденнаяПартия;
			КонецЕсли;
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Сообщить("Ошибка при создании НСИ: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура СинхронизацияИСозданиеСправочников(Команда)
	СинхронизироватьНСИНаСервере();
	ПоказатьОповещениеПользователя("Готово", , "Синхронизация справочников завершена");
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗагрузку(Команда)
	
	Путь = Объект.ФайлЗагрузки;

    Если Путь = "" Тогда
        Сообщить("Укажите путь к файлу Excel.");
        Возврат;
    КонецЕсли;
    
    Попытка
        // Очищаем существующую таблицу значений
        Реквизит1.Очистить();
        
        // Подключаем Excel
        ExcelApp = Новый COMОбъект("Excel.Application");
        ExcelApp.Visible = Ложь;
        Книга = ExcelApp.Workbooks.Open(Путь);
        Лист = Книга.Worksheets(1);
        
        Строк = Лист.UsedRange.Rows.Count;
        
        Для i = 2 По Строк Цикл // первая строка - заголовки
            НоваяСтрока =         Реквизит1.Добавить();
            
            НоваяСтрока.Номенклатура 	= Лист.Cells(i,1).Value;
            НоваяСтрока.Цвет 			= Лист.Cells(i,2).Value;
            НоваяСтрока.ral 			= Лист.Cells(i,3).Value;
            НоваяСтрока.Партия 			= Лист.Cells(i,4).Value;
            НоваяСтрока.Количество 		= Лист.Cells(i,5).Value;
            НоваяСтрока.Комплект 		= Лист.Cells(i,6).Value;
            НоваяСтрока.Фасовка 		= Лист.Cells(i,7).Value;
			//НоваяСтрока.ВесОтвердителя 	= Лист.Cells(i,8).Value;
            НоваяСтрока.Брак			= Лист.Cells(i,9).Value; 
			НоваяСтрока.Примечание		= Лист.Cells(i,10).Value;
            НоваяСтрока.ВходнойКонтроль = Лист.Cells(i,11).Value;
            НоваяСтрока.Счет			= Лист.Cells(i,12).Value;
            НоваяСтрока.МестоХранения 	= Лист.Cells(i,13).Value;
            НоваяСтрока.Контрагент		= Лист.Cells(i,14).Value;
            НоваяСтрока.Цена 			= Лист.Cells(i,15).Value;
                       
        КонецЦикла;
        
        Книга.Close(Ложь);
        ExcelApp.Quit();
        Книга = Неопределено;
		Лист = Неопределено;
		ExcelApp = Неопределено;
        
        Сообщить("Данные успешно загружены.");
        
    Исключение
        Сообщить("Ошибка при загрузке Excel: " + ОписаниеОшибки());
    КонецПопытки;

КонецПроцедуры
