
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Включаем запись и автоматическую блокировку измерений регистра
	Движения.ОстаткиМатериалов.Записывать 				= Истина;
	Движения.ОстаткиМатериалов.БлокироватьДляИзменения 	= Истина;
	
	Движения.Продажи.Записывать 						= Истина;
	
	
	// Сначала записываем пустые наборы, чтобы заблокировать управляемыми блокировками 
	// только те строки, которые выбраны в документе (для этого платформа использует данные ТЧ)
	Движения.Записать();	
	
	//ОПРЕДЕЛЯЕМ ИЗМЕРЕНИЕ: Списываем из резерва (счет заполнен) или из свободных (счет пустой)
	СчетСписания = ?(ЗначениеЗаполнено(ЗаказКлиента), ЗаказКлиента, Документы.ЗаказКлиента.ПустаяСсылка());	
	
	// 2. ЗАПРОС: Получаем себестоимость из остатков склада по конкретному Счету
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("СчетСписания", СчетСписания);
	Запрос.УстановитьПараметр("ГраницаКонтроля", Новый Граница(МоментВремени(), ВидГраницы.Включая));	
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЧТовары.Номенклатура КАК Номенклатура,
		|	ТЧТовары.Характеристика КАК Характеристика,
		|	ТЧТовары.Партия КАК Партия,
		|	ТЧТовары.Количество КАК КоличествоДок,
		|	ТЧТовары.Сумма КАК ВыручкаДок,
		|	ЕСТЬNULL(СкладОстатки.ОстатокОстаток, 0) КАК ОстатокОстаток,
		|	ЕСТЬNULL(СкладОстатки.СуммаОстаток, 0) КАК СуммаОстаток
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.Товары КАК ТЧТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиМатериалов.Остатки(
		|				&ГраницаКонтроля,
		|				(Счет, Наименование, Характеристики, Партия) В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						&СчетСписания, Т.Номенклатура, Т.Характеристика, Т.Партия
		|					ИЗ
		|						Документ.РеализацияТоваровУслуг.Товары КАК Т
		|					ГДЕ
		|						Т.Ссылка = &Ссылка)
		|			) КАК СкладОстатки
		|		ПО ТЧТовары.Номенклатура = СкладОстатки.Наименование
		|			И ТЧТовары.Характеристика = СкладОстатки.Характеристики
		|			И ТЧТовары.Партия = СкладОстатки.Партия
		|			И СкладОстатки.Счет = &СчетСписания
		|ГДЕ
		|	ТЧТовары.Ссылка = &Ссылка";
		
	РезультатДок = Запрос.Выполнить();
	Если РезультатДок.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаТоваров = РезультатДок.Выбрать();
	
	// 3. ФОРМИРОВАНИЕ ДВИЖЕНИЙ В ЦИКЛЕ
	Пока ВыборкаТоваров.Следующий() Цикл
		
		// Рассчитываем себестоимость списываемой партии (Защита от деления на 0)
		ТекущаяСебестоимость = 0;
		Если ВыборкаТоваров.ОстатокОстаток > 0 Тогда
			ТекущаяСебестоимость = (ВыборкаТоваров.СуммаОстаток / ВыборкаТоваров.ОстатокОстаток) * ВыборкаТоваров.КоличествоДок;
		Иначе
			// Если на складе уже минус, списываем по 0 (ошибка запишется ниже при контроле)
			ТекущаяСебестоимость = 0;
		КонецЕсли;
		
		// Единое движение по складу (срабатывает и для резерва, и для свободных остатков)
		ДвижениеОстатки 				= Движения.ОстаткиМатериалов.Добавить();
		ДвижениеОстатки.ВидДвижения 	= ВидДвиженияНакопления.Расход;
		ДвижениеОстатки.Период 			= Дата;
		ДвижениеОстатки.Счет 			= СчетСписания;
		ДвижениеОстатки.Наименование 	= ВыборкаТоваров.Номенклатура;
		ДвижениеОстатки.Характеристики 	= ВыборкаТоваров.Характеристика;
		ДвижениеОстатки.Партия 			= ВыборкаТоваров.Партия;
		ДвижениеОстатки.Остаток 		= ВыборкаТоваров.КоличествоДок;
		ДвижениеОстатки.Сумма 			= ТекущаяСебестоимость; // Списываем деньги со склада
		
		//Движение по продажам (Финансовый оборот: Выручка vs Себестоимость)
		ДвижениеПродажи 					= Движения.Продажи.Добавить();
		ДвижениеПродажи.Период 				= Дата;
		ДвижениеПродажи.Контрагент 			= Контрагент;
		ДвижениеПродажи.ЗаказКлиента 		= ЗаказКлиента; // Будет пустой, если свободная продажа
		ДвижениеПродажи.Номенклатура 		= ВыборкаТоваров.Номенклатура;
		ДвижениеПродажи.Характеристика 		= ВыборкаТоваров.Характеристика;
		
		ДвижениеПродажи.Количество 			= ВыборкаТоваров.КоличествоДок;
		ДвижениеПродажи.Выручка 			= ВыборкаТоваров.ВыручкаДок;             // То, что заплатил клиент
		ДвижениеПродажи.Себестоимость 		= ТекущаяСебестоимость;         // То, во сколько товар обошелся нам
		
	КонецЦикла;

	Движения.ОстаткиМатериалов.Записывать = Истина;
	Движения.Продажи.Записывать = Истина;
	// Фиксируем движения в базе данных перед финальной проверкой на минусы
	Движения.Записать();
	
	// 4. ОПЕРАТИВНЫЙ КОНТРОЛЬ ОТРИЦАТЕЛЬНЫХ ОСТАТКОВ
	Если РежимПроведения = РежимПроведенияДокумента.Оперативный Тогда
		
		ЗапросКонтроля = Новый Запрос;
		ЗапросКонтроля.УстановитьПараметр("Ссылка", Ссылка);
		ЗапросКонтроля.УстановитьПараметр("СчетСписания", СчетСписания);
		ЗапросКонтроля.УстановитьПараметр("ГраницаКонтроля", Новый Граница(МоментВремени(), ВидГраницы.Включая));
		
		ЗапросКонтроля.Текст = 
			"ВЫБРАТЬ
			|	Склад.Наименование.Наименование КАК Товар,
			|	Склад.Характеристики.Наименование КАК Характеристика,
			|	Склад.Партия.Наименование КАК Партия,
			|	-Склад.ОстатокОстаток КАК Дефицит
			|ИЗ
			|	РегистрНакопления.ОстаткиМатериалов.Остатки(
			|		&ГраницаКонтроля,
			|		(Счет, Наименование, Характеристики, Партия) В
			|			(ВЫБРАТЬ РАЗЛИЧНЫЕ &СчетСписания, Т.Номенклатура, Т.Характеристика, Т.Партия 
			|			 ИЗ Документ.РеализацияТоваровУслуг.Товары КАК Т ГДЕ Т.Ссылка = &Ссылка)
			|	) КАК Склад
			|ГДЕ
			|	Склад.ОстатокОстаток < 0";
			
		РезультатКонтроля = ЗапросКонтроля.Выполнить();
		
		Если Не РезультатКонтроля.Пустой() Тогда
			Отказ = Истина;
			ВыборкаОшибок = РезультатКонтроля.Выбрать();
			Пока ВыборкаОшибок.Следующий() Цикл
				Сообщение = Новый СообщениеПользователю;
				
				// Выводим текст ошибки в зависимости от того, по какому контуру списывали
				Если ЗначениеЗаполнено(СчетСписания) Тогда
					Шаблон = "Недостаточно товара в резерве по заказу! Товар: %1 (%2), Партия: %3. Дефицит: %4 шт.";
				Иначе
					Шаблон = "Недостаточно свободного товара на складе! Товар: %1 (%2), Партия: %3. Дефицит: %4 шт.";
				КонецЕсли;
				
				Сообщение.Текст = СтрШаблон(Шаблон, ВыборкаОшибок.Товар, ВыборкаОшибок.Характеристика, ВыборкаОшибок.Партия, ВыборкаОшибок.Дефицит);
				Сообщение.Сообщить();
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры




Процедура ОбработкаЗаполнения(ДанныеЗаполнения,СтандартнаяОбработка)

	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		// Заполнение шапки
		Контрагент = ДанныеЗаполнения.Контрагент;
		ЗаказКлиента = ДанныеЗаполнения.Ссылка;
		Ответственный = ДанныеЗаполнения.Ответственный;
		ВсегоСумма = ДанныеЗаполнения.СуммаДокумента;
		Комментарий = ДанныеЗаполнения.Комментарий;

		Для Каждого ТекСтрокаТовары из ДанныеЗаполнения.Товары Цикл
			НоваяСтрока = Товары.Добавить();
			НоваяСтрока.Номенклатура = ТекСтрокаТовары.Номенклатура;
			НоваяСтрока.Характеристика = ТекСтрокаТовары.Характеристика;
			НоваяСтрока.Партия = ТекСтрокаТовары.Партия;
			НоваяСтрока.Количество = ТекСтрокаТовары.Количество;
			НоваяСтрока.Цена = ТекСтрокаТовары.Цена;
			НоваяСтрока.Сумма = ТекСтрокаТовары.Сумма;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

