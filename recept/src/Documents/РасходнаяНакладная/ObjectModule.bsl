Процедура ОбработкаПроведения(Отказ, Режим) 
   
    // 1. Указываем платформе, что мы будем писать в этот регистр
    Движения.ЗаказыРезервы.Записывать = Истина;
    
    // 2. Очищаем старые движения (если документ перепроводится)
    Движения.ЗаказыРезервы.Очистить();
    
    // 3. Формируем движения по каждой строке табличной части
    Для Каждого ТекСтрока Из Товары Цикл
        
        Если ТекСтрока.Количество <= 0 Тогда
            Продолжить; // Пропускаем пустые строки
        КонецЕсли;
        
        Движение = Движения.ЗаказыРезервы.Добавить();
        Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
        Движение.Период      = Дата;
        Движение.Счет        = Ссылка;
        
        // Переносим параметры ТЗ для производства
        Движение.Номенклатура 		= ТекСтрока.Номенклатура;
        Движение.Цвет         		= ТекСтрока.Цвет;
        Движение.RAL          		= ТекСтрока.RAL;
        Движение.Фасовка     		= ТекСтрока.Фасовка;
        Движение.ВходнойКонтроль 	= ТекСтрока.ВходнойКонтроль;
        
        // Фиксируем плановое количество
        Движение.Количество   = ТекСтрока.Количество;
        
    КонецЦикла;

КонецПроцедуры