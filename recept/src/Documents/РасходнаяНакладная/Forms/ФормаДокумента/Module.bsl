#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

    // Восстанавливаем текст в виртуальной колонке при открытии сохраненного документа
	ОбновитьВиртуальныеКолонкиНаСервере();
КонецПроцедуры


&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

    // Восстанавливаем текст в виртуальной колонке при открытии сохраненного документа
	ОбновитьВиртуальныеКолонкиНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    // Восстанавливаем текст в виртуальной колонке при открытии сохраненного документа
	ОбновитьВиртуальныеКолонкиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)

	// Проверяем, что данные пришли именно из нашей формы подбора
    Если Найти(ИсточникВыбора.ИмяФормы, "ФормаПодбора") > 0 Тогда
        
        // Если выбран массив (множественный выбор)
        Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
            Для Каждого Элемент Из ВыбранноеЗначение Цикл
                ДобавитьСтрокуИзПодбора(Элемент);
            КонецЦикла;
        Иначе
            ДобавитьСтрокуИзПодбора(ВыбранноеЗначение);
        КонецЕсли;
        
    КонецЕсли;
    
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	СтрокаТЧ = Элементы.Товары.ТекущиеДанные;
    Если СтрокаТЧ <> Неопределено Тогда
        // Сразу обновляем визуальное поле, чтобы менеджер видел результат
        СтрокаТЧ.СтрокаПоискаТовара = Строка(СтрокаТЧ.Номенклатура);
    КонецЕсли;
    
//    ОбработатьИзменениеАналитикиСтроки(СтрокаТЧ);
КонецПроцедуры

&НаКлиенте
Процедура ТоварыХарактеристикиНоменклатурыПриИзменении(Элемент)
	СтрокаТЧ = Элементы.Товары.ТекущиеДанные;
    Если СтрокаТЧ = Неопределено Тогда Возврат; КонецЕсли;
    
    ОбработатьИзменениеАналитикиСтроки(СтрокаТЧ);
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	СтрокаТЧ = Элементы.Товары.ТекущиеДанные;
    Если СтрокаТЧ = Неопределено Тогда Возврат; КонецЕсли;
    
    // Пересчет имеет смысл, только если заполнена связка Номенклатура + Характеристика
    Если АналитикаСтрокиЗаполнена(СтрокаТЧ) Тогда
        РассчитатьСтроку(СтрокаТЧ);
        ОбновитьВариантОбеспечения(СтрокаТЧ);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПродажиПриИзменении(Элемент)
	СтрокаТЧ = Элементы.Товары.ТекущиеДанные;
    Если СтрокаТЧ = Неопределено Тогда Возврат; КонецЕсли;
    
    // ЦенаПродажи не влияет на обеспечение, только на суммы
    Если АналитикаСтрокиЗаполнена(СтрокаТЧ) Тогда
        РассчитатьСтроку(СтрокаТЧ);
    КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ТоварыСтрокаПоискаТовараАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	// Отключаем стандартный поиск 1С
    СтандартнаяОбработка = Ложь;
    
    Если СтрДлина(Текст) < 2 Тогда
        Возврат; // Начинаем искать минимум с 2 символов, чтобы не грузить сервер
    КонецЕсли;
    
    // Получаем список найденных комбинаций с сервера
    ДанныеВыбора = НайтиТоварыИХарактеристикиНаСервере(Текст);
    
КонецПроцедуры

&НаКлиенте
Процедура ТоварыСтрокаПоискаТовараОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, ВыборДобавлением, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
    СтрокаТЧ = Элементы.Товары.ТекущиеДанные;
    Если СтрокаТЧ = Неопределено Тогда Возврат; КонецЕсли;
    
    // ВыбранноеЗначение — это структура, которую мы сформировали на сервере
    Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
        
        // 1. Заполняем скрытые реальные реквизиты объекта
        СтрокаТЧ.Номенклатура = ВыбранноеЗначение.Номенклатура;
        СтрокаТЧ.ХарактеристикиНоменклатуры = ВыбранноеЗначение.Характеристика;
        
        // 2. Оставляем в поле ввода красивый объединенный текст
        СтрокаТЧ.СтрокаПоискаТовара = ВыбранноеЗначение.Представление;
        
        // 3. Запускаем нашу логику расчета цен, НДС и обеспечения (из предыдущего кода)
        ОбработатьИзменениеАналитикиСтроки(СтрокаТЧ);
    КонецЕсли;        
    
КонецПроцедуры

&НаКлиенте
Процедура ТоварыСтрокаПоискаТовараОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
    СтрокаТЧ = Элементы.Товары.ТекущиеДанные;
    Если СтрокаТЧ = Неопределено Тогда Возврат; КонецЕсли;
    
    // Очищаем и строку, и скрытые данные
    СтрокаТЧ.СтрокаПоискаТовара = "";
    СтрокаТЧ.Номенклатура = ПредопределенноеЗначение("Справочник.НоменклатураМатериалы.ПустаяСсылка");
    СтрокаТЧ.ХарактеристикиНоменклатуры = ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка");
    
    // Сбрасываем расчеты
    ОбработатьИзменениеАналитикиСтроки(СтрокаТЧ);
    
КонецПроцедуры

#КонецОбласти

// =====================================================================
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ
// =====================================================================
#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Подбор(Команда)
	// Параметры для настройки поведения формы подбора
    ПараметрыФормы = Новый Структура;
    ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина); // Чтобы выбирать много позиций сразу
//    ПараметрыФормы.Вставить("МножественныйВыбор", Истина);


	// Получаем ссылку на папку "Продукция" (на сервере)
    ПапкаПродукция = ПолучитьСсылкуНаПапкуПродукция();
    
	Если ЗначениеЗаполнено(ПапкаПродукция) Тогда
        // Параметр ТекущаяСтрока заставляет дерево или список сфокусироваться на объекте
        ПараметрыФормы.Вставить("ТекущаяСтрока", ПапкаПродукция);
        Отбор = Новый Структура("Родитель", ПапкаПродукция);
		ПараметрыФормы.Вставить("Отбор", Отбор);
    КонецЕсли;
    // Открываем форму подбора. 
    // Владельцем формы указываем саму форму документа (ЭтотОбъект)
    ОткрытьФорму("Справочник.НоменклатураМатериалы.Форма.ФормаПодбора", ПараметрыФормы, ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

// =====================================================================
// ВСПОМОГАТЕЛЬНЫЕ КЛИЕНТСКИЕ ПРОЦЕДУРЫ ДЛЯ МАТЕМАТИКИ
// =====================================================================
#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция АналитикаСтрокиЗаполнена(СтрокаТЧ)
    // Строгий контроль: и товар, и характеристика должны быть выбраны
    Возврат ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) И ЗначениеЗаполнено(СтрокаТЧ.ХарактеристикиНоменклатуры);
КонецФункции

&НаКлиенте
Процедура ОбработатьИзменениеАналитикиСтроки(СтрокаТЧ)
    
    Если АналитикаСтрокиЗаполнена(СтрокаТЧ) Тогда
        // считаем все только когда об                                                                                                                                                                                                                                           с                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   а поля готовы
        
        РассчитатьСтроку(СтрокаТЧ);
        ОбновитьВариантОбеспечения(СтрокаТЧ);
    Иначе
        // Если пользователь очистил характеристику или товар, сбрасываем расчеты
        СтрокаТЧ.НДССтавка 	=0;
        СтрокаТЧ.Сумма     	= 0;
        СтрокаТЧ.НДС       	= 0;
        СтрокаТЧ.ВсегоСНДС  = 0;
    КонецЕсли;                                            

КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСтроку(СтрокаТЧ)
    
    СтрокаТЧ.Сумма = СтрокаТЧ.Количество * СтрокаТЧ.ЦенаПродажи;
    
    СтрокаТЧ.НДССтавка = ПолучитьСтавкуНДСНаСервере();
    
    // НДС "сверху"
    СтрокаТЧ.НДС = СтрокаТЧ.Сумма * СтрокаТЧ.НДССтавка / 100;
    
    СтрокаТЧ.ВсегоСНДС = СтрокаТЧ.Сумма + СтрокаТЧ.НДС;
    
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВариантОбеспечения(СтрокаТЧ)
    
    // Если количество 0, запрашивать остатки бессмысленно
    Если СтрокаТЧ.Количество = 0 Тогда
        Возврат;
    КонецЕсли;
    
    СтрокаТЧ.ВариантОбеспеченияПоставки = ПолучитьВариантОбеспеченияНаСервере(
        СтрокаТЧ.Номенклатура, 
        СтрокаТЧ.ХарактеристикиНоменклатуры, 
        СтрокаТЧ.Количество
    );
    
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтрокуИзПодбора(ДанныеСтроки)
    
    // ДанныеСтроки — это строка динамического списка (структура с полями Номенклатура, Характеристика и т.д.)
    НоваяСтрока = Объект.Товары.Добавить();
    ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеСтроки);
    
    // Если в списке поле называлось "СвободныйОстаток", а в ТЧ документа — "Количество", 
    // можно заполнить его по умолчанию:
    // НоваяСтрока.Количество = 1; 
    
    // Вызываем нашу логику расчета цен и НДС
    ОбработатьИзменениеАналитикиСтроки(НоваяСтрока);
    
    // Обновляем текст в нашей виртуальной колонке поиска (Item + Char)
    НоваяСтрока.СтрокаПоискаТовара = Строка(НоваяСтрока.Номенклатура) 
        + ?(ЗначениеЗаполнено(НоваяСтрока.ХарактеристикиНоменклатуры), " (" + Строка(НоваяСтрока.ХарактеристикиНоменклатуры) + ")", "");

КонецПроцедуры


// =====================================================================
// СЕРВЕРНЫЕ ФУНКЦИИ БЕЗ КОНТЕКСТА 
// (Остаются без изменений, логика полностью актуальна)
// =====================================================================

&НаСервереБезКонтекста
Функция ПолучитьСтавкуНДСНаСервере()
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |    СтавкаНДСТовар.Ставка КАК Ставка
        |ИЗ
        |    РегистрСведений.СтавкаНДСТовар КАК СтавкаНДСТовар";
        
    Результат = Запрос.Выполнить();
    
    Если Не Результат.Пустой() Тогда
        Выборка = Результат.Выбрать();
        Выборка.Следующий();
        Возврат Выборка.Ставка;
    КонецЕсли;
    
    Возврат 0; 
    
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьВариантОбеспеченияНаСервере(Номенклатура, Характеристика, ТребуемоеКоличество)
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |    ЕСТЬNULL(СУММА(Остатки.ОстатокОстаток), 0) КАК СвободныйОстаток
        |ИЗ
        |    РегистрНакопления.ОстаткиМатериалов.Остатки(
        |        ,
        |        Наименование = &Номенклатура
        |            И Характеристики = &Характеристика
        |            И Счет = ЗНАЧЕНИЕ(Документ.РасходнаяНакладная.ПустаяСсылка)) КАК Остатки";
        
    Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
    Запрос.УстановитьПараметр("Характеристика", Характеристика);
    
    СвободныйОстаток = 0;
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        СвободныйОстаток = Выборка.СвободныйОстаток;
    КонецЕсли;
    
    Если СвободныйОстаток <= 0 Тогда
        Возврат Перечисления.ВариантОбеспеченияПоставки.ТолькоПроизводство;
    ИначеЕсли СвободныйОстаток >= ТребуемоеКоличество Тогда
        Возврат Перечисления.ВариантОбеспеченияПоставки.Резерв;
    Иначе
        Возврат Перечисления.ВариантОбеспеченияПоставки.РезервИДопроизводство;
    КонецЕсли;
    
КонецФункции

&НаСервереБезКонтекста
Функция НайтиТоварыИХарактеристикиНаСервере(ТекстПоиска)
    
    СписокВыбора = Новый СписокЗначений;
    
    // Подготавливаем массив разрешенных типов
    ДопустимыеТипы = Новый Массив;
    ДопустимыеТипы.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Продукция"));
    ДопустимыеТипы.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Комплект"));
    
    Запрос = Новый Запрос;
    // Ищем вхождение текста либо в имя товара, либо в имя характеристики
    Запрос.Текст = 
        "ВЫБРАТЬ ПЕРВЫЕ 30
        |	СпрНом.Ссылка КАК Номенклатура,
        |	ЕСТЬNULL(СпрХар.Ссылка, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Характеристика,
        |	СпрНом.Наименование КАК ИмяНом,
        |	ЕСТЬNULL(СпрХар.Наименование, """") КАК ИмяХар
        |ИЗ
        |	Справочник.НоменклатураМатериалы КАК СпрНом
        |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК СпрХар
        |		ПО СпрХар.Владелец = СпрНом.Ссылка
        |ГДЕ
        |	СпрНом.ЭтоГруппа = ЛОЖЬ
         |	И СпрНом.ПометкаУдаления = ЛОЖЬ
        |	// ФИЛЬТР ПО ТИПУ НОМЕНКЛАТУРЫ
        |	И СпрНом.ТипНоменклатуры В (&ДопустимыеТипы)
        |	И (ВЫРАЗИТЬ(СпрНом.Наименование КАК СТРОКА(250)) + "" "" + ЕСТЬNULL(СпрХар.Наименование, """")) ПОДОБНО &ТекстПоиска";

        
    // Оборачиваем текст в %, чтобы искать по подстроке
    Запрос.УстановитьПараметр("ТекстПоиска", "%" + ТекстПоиска + "%");
    Запрос.УстановитьПараметр("ДопустимыеТипы", ДопустимыеТипы);
    
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        
        // Формируем красивое представление: "Кабель (220В)"
        ТекПредставление = Выборка.ИмяНом;
        Если ЗначениеЗаполнено(Выборка.Характеристика) Тогда
            ТекПредставление = ТекПредставление + " (" + Выборка.ИмяХар + ")";
        КонецЕсли;
        
        // Упаковываем ссылки в структуру, чтобы передать их обратно на клиент
        ДанныеСвязки = Новый Структура;
        ДанныеСвязки.Вставить("Номенклатура", Выборка.Номенклатура);
        ДанныеСвязки.Вставить("Характеристика", Выборка.Характеристика);
        ДанныеСвязки.Вставить("Представление", ТекПредставление);
        
        // Добавляем в выпадающий список (Значение, Представление)
        СписокВыбора.Добавить(ДанныеСвязки, ТекПредставление);
        
    КонецЦикла;
    
    Возврат СписокВыбора;
    
КонецФункции

&НаСервере
Процедура ОбновитьВиртуальныеКолонкиНаСервере()
    
    Для Каждого СтрокаТЧ Из Объект.Товары Цикл
        
        // Формируем текст: Товар (Характеристика)
        Текст = Строка(СтрокаТЧ.Номенклатура);
        Если ЗначениеЗаполнено(СтрокаТЧ.ХарактеристикиНоменклатуры) Тогда
            Текст = Текст + " (" + Строка(СтрокаТЧ.ХарактеристикиНоменклатуры) + ")";
        КонецЕсли;
        
        СтрокаТЧ.СтрокаПоискаТовара = Текст;
        
    КонецЦикла;
    
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСсылкуНаПапкуПродукция()
    // Вариант 1: Поиск по наименованию (если нет предопределенной)
    Возврат Справочники.НоменклатураМатериалы.НайтиПоНаименованию("Продукция", Истина);
    
    // Вариант 2: Если есть предопределенная папка (лучший вариант)
