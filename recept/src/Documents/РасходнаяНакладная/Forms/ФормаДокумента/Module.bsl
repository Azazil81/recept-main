&НаСервере
Процедура РассчитатьОстаткиКПроизводствуНаСервере()
    
    // Запрос для получения текущих долгов производства по этому Счету
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |   ЗаказыРезервыОстатки.Номенклатура КАК Номенклатура,
        |   ЗаказыРезервыОстатки.Цвет КАК Цвет,
        |   ЗаказыРезервыОстатки.RAL КАК RAL,
        |   ЗаказыРезервыОстатки.Фасовка КАК Фасовка,
        |   ЗаказыРезервыОстатки.КоличествоОстаток КАК ОстатокКПроизводству
        |ИЗ
        |   РегистрНакопления.ЗаказыРезервы.Остатки(
        |       ,
        |       Счет = &СчетНаОплату
        |   ) КАК ЗаказыРезервыОстатки";
        
    Запрос.УстановитьПараметр("СчетНаОплату", Объект.Ссылка);
    ТаблицаОстатков = Запрос.Выполнить().Выгрузить();
    
    // Заполняем виртуальную колонку в табличной части на форме
    Для Каждого СтрокаТЧ Из Объект.Товары Цикл
        
        // Ищем соответствующую строку в остатках (учитывая все характеристики)
        СтруктураПоиска = Новый Структура("Номенклатура, Цвет, RAL, Фасовка");
        ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаТЧ);
        
        НайденныеСтроки = ТаблицаОстатков.НайтиСтроки(СтруктураПоиска);
        
        Если НайденныеСтроки.Количество() > 0 Тогда
            СтрокаТЧ.ОсталосьПроизвести = НайденныеСтроки[0].ОстатокКПроизводству;
        Иначе
            // Если остатка в регистре нет, значит цех выпустил весь объем (или заказ еще не проведен)
            Если Объект.Проведен Тогда
                СтрокаТЧ.ОсталосьПроизвести = 0; 
            Иначе
                СтрокаТЧ.ОсталосьПроизвести = СтрокаТЧ.Количество;
            КонецЕсли;
        КонецЕсли;
        
    КонецЦикла;
    
КонецПроцедуры
#КонецОбласти