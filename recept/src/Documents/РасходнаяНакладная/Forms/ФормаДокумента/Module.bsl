
#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	СтрокаТЧ = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТЧ = Неопределено Тогда Возврат; КонецЕсли;
    
    ОбработатьИзменениеАналитикиСтроки(СтрокаТЧ);
КонецПроцедуры

&НаКлиенте
Процедура ТоварыХарактеристикиНоменклатурыПриИзменении(Элемент)
	СтрокаТЧ = Элементы.Товары.ТекущиеДанные;
    Если СтрокаТЧ = Неопределено Тогда Возврат; КонецЕсли;
    
    ОбработатьИзменениеАналитикиСтроки(СтрокаТЧ);
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	СтрокаТЧ = Элементы.Товары.ТекущиеДанные;
    Если СтрокаТЧ = Неопределено Тогда Возврат; КонецЕсли;
    
    // Пересчет имеет смысл, только если заполнена связка Номенклатура + Характеристика
    Если АналитикаСтрокиЗаполнена(СтрокаТЧ) Тогда
        РассчитатьСтроку(СтрокаТЧ);
        ОбновитьВариантОбеспечения(СтрокаТЧ);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПродажиПриИзменении(Элемент)
	СтрокаТЧ = Элементы.Товары.ТекущиеДанные;
    Если СтрокаТЧ = Неопределено Тогда Возврат; КонецЕсли;
    
    // Цена не влияет на обеспечение, только на суммы
    Если АналитикаСтрокиЗаполнена(СтрокаТЧ) Тогда
        РассчитатьСтроку(СтрокаТЧ);
    КонецЕсли;
КонецПроцедуры

#КонецОбласти

// =====================================================================
// ВСПОМОГАТЕЛЬНЫЕ КЛИЕНТСКИЕ ПРОЦЕДУРЫ ДЛЯ МАТЕМАТИКИ
// =====================================================================
#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция АналитикаСтрокиЗаполнена(СтрокаТЧ)
    // Строгий контроль: и товар, и характеристика должны быть выбраны
    Возврат ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) И ЗначениеЗаполнено(СтрокаТЧ.ХарактеристикиНоменклатуры);
КонецФункции

&НаКлиенте
Процедура ОбработатьИзменениеАналитикиСтроки(СтрокаТЧ)
    
    Если АналитикаСтрокиЗаполнена(СтрокаТЧ) Тогда
        // Запрашиваем НДС и считаем все только когда оба поля готовы
        СтрокаТЧ.СтавкаНДС = ПолучитьСтавкуНДСНаСервере(СтрокаТЧ.Номенклатура);
        
        РассчитатьСтроку(СтрокаТЧ);
        ОбновитьВариантОбеспечения(СтрокаТЧ);
    Иначе
        // Если пользователь очистил характеристику или товар, сбрасываем расчеты
        СтрокаТЧ.СтавкаНДС = 0;
        СтрокаТЧ.Сумма     = 0;
        СтрокаТЧ.НДС       = 0;
        СтрокаТЧ.ВсегоНДС  = 0;
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСтроку(СтрокаТЧ)
    
    СтрокаТЧ.Сумма = СтрокаТЧ.Количество * СтрокаТЧ.Цена;
    
    // НДС "сверху"
    СтрокаТЧ.НДС = СтрокаТЧ.Сумма * СтрокаТЧ.СтавкаНДС / 100;
    
    СтрокаТЧ.ВсегоНДС = СтрокаТЧ.Сумма + СтрокаТЧ.НДС;
    
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВариантОбеспечения(СтрокаТЧ)
    
    // Если количество 0, запрашивать остатки бессмысленно
    Если СтрокаТЧ.Количество = 0 Тогда
        Возврат;
    КонецЕсли;
    
    СтрокаТЧ.ВариантОбеспеченияПоставки = ПолучитьВариантОбеспеченияНаСервере(
        СтрокаТЧ.Номенклатура, 
        СтрокаТЧ.ХарактеристикиНоменклатуры, 
        СтрокаТЧ.Количество
    );
    
КонецПроцедуры


// =====================================================================
// СЕРВЕРНЫЕ ФУНКЦИИ БЕЗ КОНТЕКСТА 
// (Остаются без изменений, логика полностью актуальна)
// =====================================================================

&НаСервереБезКонтекста
Функция ПолучитьСтавкуНДСНаСервере(Номенклатура)
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |    НДСАтрибутТовара.Ставка КАК Ставка
        |ИЗ
        |    РегистрСведений.НДСАтрибутТовара КАК НДСАтрибутТовара
        |ГДЕ
        |    НДСАтрибутТовара.Номенклатура = &Номенклатура";
        
    Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
    Результат = Запрос.Выполнить();
    
    Если Не Результат.Пустой() Тогда
        Выборка = Результат.Выбрать();
        Выборка.Следующий();
        Возврат Выборка.Ставка;
    КонецЕсли;
    
    Возврат 0; 
    
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьВариантОбеспеченияНаСервере(Номенклатура, Характеристика, ТребуемоеКоличество)
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |    ЕСТЬNULL(СУММА(Остатки.ОстатокОстаток), 0) КАК СвободныйОстаток
        |ИЗ
        |    РегистрНакопления.ОстаткиМатериалов.Остатки(
        |        ,
        |        Наименование = &Номенклатура
        |            И Характеристики = &Характеристика
        |            И Счет = ЗНАЧЕНИЕ(Документ.РасходнаяНакладная.ПустаяСсылка)) КАК Остатки";
        
    Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
    Запрос.УстановитьПараметр("Характеристика", Характеристика);
    
    СвободныйОстаток = 0;
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        СвободныйОстаток = Выборка.СвободныйОстаток;
    КонецЕсли;
    
    Если СвободныйОстаток <= 0 Тогда
        Возврат Перечисления.ВариантОбеспеченияПоставки.ТолькоПроизводство;
    ИначеЕсли СвободныйОстаток >= ТребуемоеКоличество Тогда
        Возврат Перечисления.ВариантОбеспеченияПоставки.Резерв;
    Иначе
        Возврат Перечисления.ВариантОбеспеченияПоставки.РезервИДопроизводство;
    КонецЕсли;
    
КонецФункции

#КонецОбласти