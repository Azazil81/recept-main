&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	Колво = Объект.Товары.Итог("Количество");
	Продано = Объект.Товары.Итог("Продано");
	Остаток = Объект.Товары.Итог("Остаток");  
