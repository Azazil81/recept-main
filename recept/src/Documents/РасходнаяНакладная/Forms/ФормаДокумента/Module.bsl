// Пересчитывает цену продажи товара при изменении суммы в табличной части.
//
// Параметры:
//   Элемент - Число - Элемент управления, вызвавший событие изменения.
&НаКлиенте
Процедура ТоварыСуммаПриИзменении(Элемент)

	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТабличнойЧасти.Количество = 0 Тогда
		СтрокаТабличнойЧасти.ЦенаПродажи = 0;
	Иначе
		СтрокаТабличнойЧасти.ЦенаПродажи = СтрокаТабличнойЧасти.Сумма / СтрокаТабличнойЧасти.Количество;
	КонецЕсли;

КонецПроцедуры


