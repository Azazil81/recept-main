
Процедура ОбработкаПроведения(Отказ, Режим)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	// 1. ИНИЦИАЛИЗАЦИЯ И ОЧИСТКА ДВИЖЕНИЙ
	Движения.ЗаказыРезервы.Записывать = Истина;
	Движения.ОстаткиМатериалов.Записывать = Истина;
	Движения.Записать();
	
	// 2. ПОДГОТОВКА ЗАПРОСА (Работаем напрямую с измерением регистра)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ГраницаКонтроля", Новый Граница(МоментВремени(), ВидГраницы.Включая));
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЧПродукция.НаменованиеПродукции КАК Номенклатура,
		|	ТЧПродукция.Характеристики КАК Характеристика,
		|	ТЧПродукция.Ссылка КАК Партия,
		|	СУММА(ТЧПродукция.Количество) КАК КоличествоВыпуска
		|ПОМЕСТИТЬ ВТ_Выпуск
		|ИЗ
		|	Документ.ВыпускПродукции.Продукция КАК ТЧПродукция
		|ГДЕ
		|	ТЧПродукция.Ссылка = &Ссылка
		|СГРУППИРОВАТЬ ПО
		|	ТЧПродукция.Номенклатура,
		|	ТЧПродукция.Характеристика,
		|	ТЧПродукция.Партия
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Выпуск.Номенклатура КАК Номенклатура,
		|	ВТ_Выпуск.Характеристика КАК Характеристика,
		|	ВТ_Выпуск.Партия КАК Партия,
		|	ВТ_Выпуск.КоличествоВыпуска КАК КоличествоВыпуска,
		|	ЕСТЬNULL(РезервыОстатки.ЗаказПокупателя, ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)) КАК ЗаказПокупателя,
		|	ЕСТЬNULL(РезервыОстатки.ДатаОтгрузки, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаГотовности,
		|	ЕСТЬNULL(РезервыОстатки.КоличествоОстаток, 0) КАК КоличествоПотребность
		|ИЗ
		|	ВТ_Выпуск КАК ВТ_Выпуск
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыРезервы.Остатки(
		|				&ГраницаКонтроля,
		|				(Номенклатура, Характеристика) В
		|					(ВЫБРАТЬ ВТ.Номенклатура, ВТ.Характеристика ИЗ ВТ_Выпуск КАК ВТ)
		|			) КАК РезервыОстатки
		|		ПО ВТ_Выпуск.Номенклатура = РезервыОстатки.Номенклатура
		|			И ВТ_Выпуск.Характеристика = РезервыОстатки.Характеристика
		|УПОРЯДОЧИТЬ ПО
		|	Номенклатура,
		|	Характеристика,
		|	Партия,
		|	ДатаГотовности ВОЗР"; 
		
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	ТекущаяНоменклатура   = Неопределено;
	ТекущаяХарактеристика = Неопределено;
	ТекущаяПартия         = Неопределено;
	ОсталосьРаспределить  = 0;
	
	// 3. РАСПРЕДЕЛЕНИЕ ВЫПУСКА
	Пока Выборка.Следующий() Цикл
		
		Если ТекущаяНоменклатура <> Выборка.Номенклатура 
			Или ТекущаяХарактеристика <> Выборка.Характеристика 
			Или ТекущаяПартия <> Выборка.Партия Тогда
			
			// Списываем излишек предыдущей номенклатуры на свободный склад (Счет пустой)
			Если ОсталосьРаспределить > 0 Тогда
				ДвижениеСвободный = Движения.ОстаткиМатериалов.Добавить();
				ДвижениеСвободный.ВидДвижения   = ВидДвиженияНакопления.Приход;
				ДвижениеСвободный.Период        = Дата;
				ДвижениеСвободный.Наименование  = ТекущаяНоменклатура;
				ДвижениеСвободный.Характеристики = ТекущаяХарактеристика;
				ДвижениеСвободный.Партия        = ТекущаяПартия;
				ДвижениеСвободный.Счет          = Документы.ЗаказПокупателя.ПустаяСсылка();
				ДвижениеСвободный.Остаток       = ОсталосьРаспределить;
			КонецЕсли;
			
			ТекущаяНоменклатура   = Выборка.Номенклатура;
			ТекущаяХарактеристика = Выборка.Характеристика;
			ТекущаяПартия         = Выборка.Партия;
			ОсталосьРаспределить  = Выборка.КоличествоВыпуска;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Выборка.ЗаказПокупателя) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ОсталосьРаспределить = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		РаспределеноНаЗаказ = Мин(ОсталосьРаспределить, Выборка.КоличествоПотребность);
		
		Если РаспределеноНаЗаказ > 0 Тогда
			
			// Расход из резервов
			ДвижениеРезерв = Движения.ЗаказыРезервы.Добавить();
			ДвижениеРезерв.ВидДвижения     = ВидДвиженияНакопления.Расход;
			ДвижениеРезерв.Период          = Дата;
			ДвижениеРезерв.Номенклатура    = Выборка.Номенклатура;
			ДвижениеРезерв.Характеристика = Выборка.Характеристика;
			ДвижениеРезерв.ЗаказПокупателя = Выборка.ЗаказПокупателя;
			ДвижениеРезерв.ДатаОтгрузки    = Выборка.ДатаГотовности; // Заполняем измерение при расходе
			ДвижениеРезерв.Количество      = РаспределеноНаЗаказ;
			
			// Приход в остатки материалов (под конкретный заказ)
			ДвижениеОстатки = Движения.ОстаткиМатериалов.Добавить();
			ДвижениеОстатки.ВидДвижения   = ВидДвиженияНакопления.Приход;
			ДвижениеОстатки.Период        = Дата;
			ДвижениеОстатки.Наименование  = Выборка.Номенклатура;
			ДвижениеОстатки.Характеристики = Выборка.Характеристика;
			ДвижениеОстатки.Партия        = Выборка.Партия;
			ДвижениеОстатки.Счет          = Выборка.ЗаказПокупателя; 
			ДвижениеОстатки.Остаток       = РаспределеноНаЗаказ;
			
			ОсталосьРаспределить = ОсталосьРаспределить - РаспределеноНаЗаказ;
		КонецЕсли;
		
	КонецЦикла;
	
	// 4. ОБРАБОТКА ИЗЛИШКА ПОСЛЕДНЕЙ ПОЗИЦИИ
	Если ОсталосьРаспределить > 0 Тогда
		ДвижениеСвободный = Движения.ОстаткиМатериалов.Добавить();
		ДвижениеСвободный.ВидДвижения   = ВидДвиженияНакопления.Приход;
		ДвижениеСвободный.Период        = Дата;
		ДвижениеСвободный.Наименование  = ТекущаяНоменклатура;
		ДвижениеСвободный.Характеристики = ТекущаяХарактеристика;
		ДвижениеСвободный.Партия        = ТекущаяПартия;
		ДвижениеСвободный.Счет          = Документы.ЗаказПокупателя.ПустаяСсылка();
		ДвижениеСвободный.Остаток       = ОсталосьРаспределить;
	КонецЕсли;
    
    
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)

	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.Рецептуры") Тогда
		НомерДокументаОснования = ДанныеЗаполнения.Наименование;
		Примечание = ДанныеЗаполнения.Примечание;
		ДокументОснование = ДанныеЗаполнения.Ссылка;
		Номер = ДанныеЗаполнения.Номер;
		Для Каждого ТекСтрокаПродукция Из ДанныеЗаполнения.Продукция Цикл  
			Если ТекСтрокаПродукция.СостояниеОбеспечения = Перечисления.СтатусыГотовностиПродукции.ВРаботе Тогда
				НоваяСтрока = Продукция.Добавить();
				НоваяСтрока.Количество = ТекСтрокаПродукция.Количество;
				НоваяСтрока.НаменованиеПродукции = ТекСтрокаПродукция.Наименование;
				НоваяСтрока.СостояниеОбеспечения = Перечисления.СтатусыГотовностиПродукции.ГотовКОтгрузке;
				НоваяСтрока.Цена = ТекСтрокаПродукция.Цена;
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры
