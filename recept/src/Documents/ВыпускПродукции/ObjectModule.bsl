Процедура ОбработкаЗаполнения(ДанныеЗаполнения,СтандартнаяОбработка)

	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.Производство") Тогда
		// Заполнение шапки
		Номенклатура = ДанныеЗаполнения.Номенклатура;
		Характеристика = ДанныеЗаполнения.Характеристика;
		Количество = ДанныеЗаполнения.Количество;

	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	// 1. ИНИЦИАЛИЗАЦИЯ И ОЧИСТКА ДВИЖЕНИЙ
	Движения.ЗаказыРезервы.Записывать = Истина;
	Движения.ОстаткиМатериалов.Записывать = Истина;
	Движения.СтадииВыполненияЗаказов.Записывать = Истина; // Включаем новый регистр статусов
	Движения.Записать();
	
	// 2. АВТОМАТИЧЕСКОЕ СОЗДАНИЕ ПАРТИИ В СПРАВОЧНИКЕ
	НоваяПартия 					= Справочники.Партии.СоздатьЭлемент();
	НоваяПартия.Владелец            = Характеристика; 
	НоваяПартия.Наименование        = Номер; 
	НоваяПартия.ДокументИсточник    = Ссылка;
	НоваяПартия.ВходнойКонтроль     = ВходнойКонтроль;
	НоваяПартия.Вязкость            = Вязкость;
	НоваяПартия.Перетир             = Перетир;
	НоваяПартия.ДатаВыпуска         = Дата;
	НоваяПартия.Примечание          = Примечание;
	НоваяПартия.Брак                = Брак;
	НоваяПартия.МестоХранения       = МестоХранения; 
	
	Попытка
		НоваяПартия.Записать();
	Исключение
		ВызватьИсключение "Не удалось создать элемент справочника Партии: " + ОписаниеОшибки();
	КонецПопытки;
	
	СсылкаНаПартию = НоваяПартия.Ссылка;

	// 3. ПОДГОТОВКА ЗАПРОСА ДЛЯ ПОДБОРА ЗАКАЗОВ (По условию ВПроизводствеОстаток > 0)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номенклатура",    Номенклатура);
	Запрос.УстановитьПараметр("Характеристика",  Характеристика);
	Запрос.УстановитьПараметр("ГраницаКонтроля", Новый Граница(МоментВремени(), ВидГраницы.Включая));
	
	// Выбираем заказы, которые реально находятся на этапе производства
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СтадииОстатки.ЗаказКлиента КАК ЗаказПокупателя,
		|	ЕСТЬNULL(СтадииОстатки.ЗаказКлиента.ДатаОтгрузки, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОтгрузки,
		|	ЕСТЬNULL(СтадииОстатки.ВПроизводствеОстаток, 0) КАК КоличествоПотребность
		|ИЗ
		|	РегистрНакопления.СтадииВыполненияЗаказов.Остатки(
		|			&ГраницаКонтроля,
		|			Номенклатура = &Номенклатура
		|				И Характеристика = &Характеристика
		|		) КАК СтадииОстатки
		|ГДЕ
		|	СтадииОстатки.ВПроизводствеОстаток > 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаОтгрузки ВОЗР"; // Алгоритм EDD / FIFO
		
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ОсталосьРаспределить = Количество; // Общий объем выпуска из шапки
	
	// Взводим флаги заново ПЕРЕД добавлением новых движений
	Движения.ЗаказыРезервы.Записывать = Истина;
	Движения.ОстаткиМатериалов.Записывать = Истина;
	Движения.СтадииВыполненияЗаказов.Записывать = Истина;
	
	// 4. РАСПРЕДЕЛЕНИЕ ВЫПУСКА ПО ОЧЕРЕДИ ПОТРЕБНОСТЕЙ
	Пока Выборка.Следующий() И ОсталосьРаспределить > 0 Цикл
		
		// Сколько продукции заберет текущий заказ из очереди
		РаспределеноНаЗаказ = Мин(ОсталосьРаспределить, Выборка.КоличествоПотребность);
		
		Если РаспределеноНаЗаказ > 0 Тогда
			
			// А. Уменьшаем потребность в регистре ЗаказыРезервы
			ДвижениеРезерв 					= Движения.ЗаказыРезервы.Добавить();
			ДвижениеРезерв.ВидДвижения      = ВидДвиженияНакопления.Расход;
			ДвижениеРезерв.Период           = Дата;
			ДвижениеРезерв.Номенклатура     = Номенклатура;
			ДвижениеРезерв.Характеристики   = Характеристика;
			ДвижениеРезерв.Счет             = Выборка.ЗаказПокупателя;
			ДвижениеРезерв.Количество       = РаспределеноНаЗаказ;
			
			// Б. Оприходуем готовую продукцию под этот конкретный заказ
			ДвижениеОстатки 				= Движения.ОстаткиМатериалов.Добавить();
			ДвижениеОстатки.ВидДвижения     = ВидДвиженияНакопления.Приход;
			ДвижениеОстатки.Период          = Дата;
			ДвижениеОстатки.Наименование    = Номенклатура;
			ДвижениеОстатки.Характеристики  = Характеристика;
			ДвижениеОстатки.Партия          = СсылкаНаПартию;
			ДвижениеОстатки.Счет            = Выборка.ЗаказПокупателя;
			ДвижениеОстатки.Остаток         = РаспределеноНаЗаказ;
			ДвижениеОстатки.Сумма           = РаспределеноНаЗаказ * Цена;
			
			// В. ИЗМЕНЕНИЕ СТАТУСОВ ПРОДУКЦИИ (Движения по новой логике)
			// Уменьшаем (списываем) количество в статусе "В производстве"
			ДвижениеСтадияРасход = Движения.СтадииВыполненияЗаказов.ДобавитьРасход();
			ДвижениеСтадияРасход.Период          = Дата;
			ДвижениеСтадияРасход.Номенклатура    = Номенклатура;
			ДвижениеСтадияРасход.Характеристика  = Характеристика;
			ДвижениеСтадияРасход.ЗаказКлиента    = Выборка.ЗаказПокупателя;
			ДвижениеСтадияРасход.ВПроизводстве   = РаспределеноНаЗаказ;

			// Увеличиваем (приходуем) количество в статус "Готово"
			ДвижениеСтадияПриход = Движения.СтадииВыполненияЗаказов.ДобавитьПриход();
			ДвижениеСтадияПриход.Период          = Дата;
			ДвижениеСтадияПриход.Номенклатура    = Номенклатура;
			ДвижениеСтадияПриход.Характеристика  = Характеристика;
			ДвижениеСтадияПриход.ЗаказКлиента    = Выборка.ЗаказПокупателя;
			ДвижениеСтадияПриход.Готово          = РаспределеноНаЗаказ;
			
			// Уменьшаем остаток для распределения
			ОсталосьРаспределить = ОсталосьРаспределить - РаспределеноНаЗаказ;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// 5. ОБРАБОТКА ИЗЛИШКА (Если краска еще осталась, отправляем на свободный склад)
	Если ОсталосьРаспределить > 0 Тогда
		
		// Свободный остаток на складе материалов
		ДвижениеСвободный 					= Движения.ОстаткиМатериалов.Добавить();
		ДвижениеСвободный.ВидДвижения       = ВидДвиженияНакопления.Приход;
		ДвижениеСвободный.Период            = Дата; 
		ДвижениеСвободный.Наименование      = Номенклатура;
		ДвижениеСвободный.Характеристики    = Характеристика;
		ДвижениеСвободный.Партия            = СсылкаНаПартию;
		ДвижениеСвободный.Счет              = Документы.ЗаказКлиента.ПустаяСсылка();
		ДвижениеСвободный.Остаток           = ОсталосьРаспределить;
		ДвижениеСвободный.Сумма             = ОсталосьРаспределить * Цена;
		
		// Свободный излишек также фиксируем в статусе "Готово" без привязки к заказу
		ДвижениеСтадияСвободный = Движения.СтадииВыполненияЗаказов.ДобавитьПриход();
		ДвижениеСтадияСвободный.Период         = Дата;
		ДвижениеСтадияСвободный.Номенклатура   = Номенклатура;
		ДвижениеСтадияСвободный.Характеристика = Характеристика;
		ДвижениеСтадияСвободный.ЗаказКлиента   = Документы.ЗаказКлиента.ПустаяСсылка();
		ДвижениеСтадияСвободный.Готово         = ОсталосьРаспределить;
		
	КонецЕсли;
	
КонецПроцедуры
