
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	// 1. ИНИЦИАЛИЗАЦИЯ И ОЧИСТКА ДВИЖЕНИЙ
	Движения.ЗаказыРезервы.Записывать = Истина;
	Движения.ОстаткиМатериалов.Записывать = Истина;
	Движения.Записать();
	
	// 2. АВТОМАТИЧЕСКОЕ СОЗДАНИЕ ПАРТИИ В СПРАВОЧНИКЕ
	// Перед распределением мы должны зафиксировать саму партию в системе
	НоваяПартия 					= Справочники.Партии.СоздатьЭлемент();
	НоваяПартия.Владелец          	= Характеристика; // Подчинен характеристике
	НоваяПартия.Наименование      	= "Партия от " + Формат(Дата, "ДФ=dd.MM.yyyy") + " (Док. №" + Номер + ")";
	НоваяПартия.ДокументИсточник  	= Ссылка;
	НоваяПартия.ВходнойКонтроль   	= ВходнойКонтроль;
	НоваяПартия.Вязкость          	= Вязкость;
	НоваяПартия.Перетир           	= Перетир;
	НоваяПартия.ДатаВыпуска  		= Дата;
	НоваяПартия.Примечание        	= Примечание;
	НоваяПартия.Брак             	= Брак;
	НоваяПартия.МестоХранения		= МестоХранения; 
	
	Попытка
		НоваяПартия.Записать();
	Исключение
		ВызватьИсключение "Не удалось создать элемент справочника Партии: " + ОписаниеОшибки();
	КонецПопытки;
	
	СсылкаНаПартию = НоваяПартия.Ссылка;

	// 3. ПОДГОТОВКА ЗАПРОСА ДЛЯ ПОДБОРА ЗАКАЗОВ (Алгоритм EDD)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номенклатура",    Номенклатура);
	Запрос.УстановитьПараметр("Характеристика",  Характеристика);
	Запрос.УстановитьПараметр("ГраницаКонтроля", Новый Граница(МоментВремени(), ВидГраницы.Включая));
	
	// Выбираем только те резервы, которые соответствуют нашему выпущенному товару
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РезервыОстатки.Счет КАК ЗаказПокупателя,
		|	ЕСТЬNULL(РезервыОстатки.Счет.ДатаОтгрузки, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОтгрузки,
		|	ЕСТЬNULL(РезервыОстатки.КоличествоОстаток, 0) КАК КоличествоПотребность
		|ИЗ
		|	РегистрНакопления.ЗаказыРезервы.Остатки(
		|			&ГраницаКонтроля,
		|			Номенклатура = &Номенклатура
		|				И Характеристики = &Характеристика
		|		) КАК РезервыОстатки
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаОтгрузки ВОЗР"; // Самые ранние/срочные заказы в начало очереди
		
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ОсталосьРаспределить = Количество; // Общий объем выпуска из шапки
	
	// Взводим флаги заново ПЕРЕД добавлением новых движений
	Движения.ЗаказыРезервы.Записывать = Истина;
	Движения.ОстаткиМатериалов.Записывать = Истина;
	
	// 4. РАСПРЕДЕЛЕНИЕ ВЫПУСКА ПО ОЧЕРЕДИ ПОТРЕБНОСТЕЙ
	Пока Выборка.Следующий() И ОсталосьРаспределить > 0 Цикл
		
		// Сколько продукции заберет текущий заказ из очереди
		РаспределеноНаЗаказ = Мин(ОсталосьРаспределить, Выборка.КоличествоПотребность);
		
		Если РаспределеноНаЗаказ > 0 Тогда
			
			// А. Уменьшаем потребность в регистре ЗаказыРезервы
			ДвижениеРезерв 					= Движения.ЗаказыРезервы.Добавить();
			ДвижениеРезерв.ВидДвижения     	= ВидДвиженияНакопления.Расход;
			ДвижениеРезерв.Период          	= Дата;
			ДвижениеРезерв.Номенклатура   	= Номенклатура;
			ДвижениеРезерв.Характеристики 	= Характеристика;
			ДвижениеРезерв.Счет 			= Выборка.ЗаказПокупателя;
			ДвижениеРезерв.Количество      	= РаспределеноНаЗаказ;
			
			// Б. Оприходуем готовую продукцию под этот конкретный заказ
			ДвижениеОстатки 				= Движения.ОстаткиМатериалов.Добавить();
			ДвижениеОстатки.ВидДвижения   	= ВидДвиженияНакопления.Приход;
			ДвижениеОстатки.Период        	= Дата;
			ДвижениеОстатки.Наименование  	= Номенклатура;
			ДвижениеОстатки.Характеристики 	= Характеристика;
			ДвижениеОстатки.Партия        	= СсылкаНаПартию; // Наша новая созданная партия
			ДвижениеОстатки.Счет          	= Выборка.ЗаказПокупателя; // Привязка к резерву
			ДвижениеОстатки.Остаток       	= РаспределеноНаЗаказ;
			
			// Уменьшаем остаток для распределения
			ОсталосьРаспределить = ОсталосьРаспределить - РаспределеноНаЗаказ;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// 5. ОБРАБОТКА ИЗЛИШКА (Если краска еще осталась, отправляем на свободный склад)
	Если ОсталосьРаспределить > 0 Тогда
		
		ДвижениеСвободный 					= Движения.ОстаткиМатериалов.Добавить();
		ДвижениеСвободный.ВидДвижения   	= ВидДвиженияНакопления.Приход;
		ДвижениеСвободный.Period        	= Дата;
		ДвижениеСвободный.Наименование  	= Номенклатура;
		ДвижениеСвободный.Характеристики 	= Характеристика;
		ДвижениеСвободный.Партия        	= СсылкаНаПартию;
		ДвижениеСвободный.Счет          	= Документы.ЗаказКлиента.ПустаяСсылка(); // Свободный остаток
		ДвижениеСвободный.Остаток       	= ОсталосьРаспределить;
		
	КонецЕсли;
	
КонецПроцедуры
