#Область ОбработчикиСобытий

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	// Принудительно записываем пустые наборы, чтобы очистить движения текущего заказа.
	// Теперь в виртуальных таблицах остатков этот заказ больше ничего не просит (ВЗаявке пропадет),
	// но запущенное производство (ВПроизводстве/Готово) останется висеть «сиротой» с отрицательным балансом ВЗаявке.
	Движения.ЗаказыРезервы.Записывать = Истина;
	Движения.ОстаткиМатериалов.Записывать = Истина;
	Движения.СтадииВыполненияЗаказов.Записывать = Истина;
	Движения.Записать();
	
	// Запускаем движок перераспределения (он подберет все сиротские остатки и закроет их)
	ПерераспределитьИзлишкиИЗаделы();
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// Если идет загрузка данных (обмен, РИБ), то никакую логику не выполняем
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	// Пересчитываем сумму только при обычной записи/проведении пользователем или кодом
	СуммаДокумента = Товары.Итог("Сумма");
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
   
Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	// 1. Подготавливаем движения
	Движения.ОстаткиМатериалов.Записывать = Истина;
	Движения.ЗаказыРезервы.Записывать = Истина;
	Движения.СтадииВыполненияЗаказов.Записывать = Истина;
	
	// 2. Подготовка данных: выгружаем ТЧ в таблицу для запроса
	ТаблицаТоваров = Товары.Выгрузить();
	
	// 3. Блокировка данных для предотвращения параллельного списания
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ОстаткиМатериалов");
	ЭлементБлокировки.ИсточникДанных = ТаблицаТоваров;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Наименование", "Номенклатура");
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Характеристики", "Характеристика");
	ЭлементБлокировки.УстановитьЗначение("Счет", Документы.ЗаказКлиента.ПустаяСсылка());
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	
	// 4. Очищаем старые движения (при перепроведении)
	Движения.ОстаткиМатериалов.Очистить();
	Движения.ЗаказыРезервы.Очистить();
	Движения.СтадииВыполненияЗаказов.Очистить();
	
	// 5. ЕДИНЫЙ ЗАПРОС (ВТ + Остатки)
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТчТовары.Номенклатура КАК Номенклатура,
		|	ТчТовары.Характеристика КАК Характеристика,
		|	ТчТовары.Количество КАК КоличествоНужно,
		|	ТчТовары.Производство КАК Производство,
		|	ТчТовары.НомерСтроки КАК НомерСтрокиТч
		|ПОМЕСТИТЬ ВТ_Нужды
		|ИЗ
		|	&ТаблицаТоваров КАК ТчТовары
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.Номенклатура КАК Номенклатура,
		|	ВТ.Характеристика КАК Характеристика,
		|	ВТ.КоличествоНужно КАК КоличествоНужно,
		|	ВТ.Производство КАК Производство,
		|	ВТ.НомерСтрокиТч КАК НомерСтрокиТч,
		|	ЕСТЬNULL(Остатки.Партия, НЕОПРЕДЕЛЕНО) КАК Партия,
		|	ЕСТЬNULL(Остатки.ОстатокОстаток, 0) КАК СвободныйОстаток
		|ИЗ
		|	ВТ_Нужды КАК ВТ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиМатериалов.Остатки(
		|				&Период,
		|				(Наименование, Характеристики) В
		|						(ВЫБРАТЬ
		|							ВТ_Нужды.Номенклатура,
		|							ВТ_Нужды.Характеристика
		|						ИЗ
		|							ВТ_Нужды
		|						ГДЕ
		|							ВТ_Нужды.Производство = ЛОЖЬ)
		|					И Счет = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)) КАК Остатки
		|		ПО ВТ.Номенклатура = Остатки.Наименование
		|			И ВТ.Характеристика = Остатки.Характеристики
		|ИТОГИ
		|	МАКСИМУМ(КоличествоНужно),
		|	СУММА(СвободныйОстаток),
		|	МАКСИМУМ(Номенклатура),
		|	МАКСИМУМ(Характеристика),
		|	МАКСИМУМ(Производство)
		|ПО
		|	НомерСтрокиТч";
	
	Запрос.УстановитьПараметр("ТаблицаТоваров", ТаблицаТоваров);
	Запрос.УстановитьПараметр("Период",         Новый Граница(МоментВремени(), ВидГраницы.Исключая));
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаСтрока = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	// 6. ОБХОД РЕЗУЛЬТАТОВ (Первичное формирование потребностей)
	Пока ВыборкаСтрока.Следующий() Цикл
		
		НужноеКоличество = ВыборкаСтрока.КоличествоНужно;
		
		Если ВыборкаСтрока.Производство Тогда
			// СЦЕНАРИЙ А: ПРОИЗВОДСТВО
			ДвЗаказы = Движения.ЗаказыРезервы.ДобавитьПриход();
			ДвЗаказы.Период          = Дата;
			ДвЗаказы.Счет            = Ссылка;
			ДвЗаказы.ДатаОтгрузки    = ДатаОтгрузки;
			ДвЗаказы.Номенклатура    = ВыборкаСтрока.Номенклатура;
			ДвЗаказы.Характеристики  = ВыборкаСтрока.Характеристика;
			ДвЗаказы.Количество      = НужноеКоличество;
			
			ДвСтадия = Движения.СтадииВыполненияЗаказов.ДобавитьПриход();
			ДвСтадия.Период          = Дата;
			ДвСтадия.ЗаказКлиента    = Ссылка;
			ДвСтадия.Номенклатура    = ВыборкаСтрока.Номенклатура;
			ДвСтадия.Характеристика  = ВыборкаСтрока.Характеристика;
			ДвСтадия.ВЗаявке         = НужноеКоличество;
			
		Иначе
			// СЦЕНАРИЙ Б: РЕЗЕРВ СО СКЛАДА
			СвободныйОстатокОбщий = ВыборкаСтрока.СвободныйОстаток;
			
			Если НужноеКоличество > СвободныйОстатокОбщий Тогда
				Отказ = Истина;
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = СтрШаблон("Строка %1: Недостаточно товара '%2'. Требуется: %3, Свободно: %4",
					ВыборкаСтрока.НомерСтрокиТч, ВыборкаСтрока.Номенклатура, НужноеКоличество, СвободныйОстатокОбщий);
				Сообщение.Поле = СтрШаблон("Товары[%1].Количество", ВыборкаСтрока.НомерСтрокиТч - 1);
				Сообщение.УстановитьДанные(ЭтотОбъект);
				Сообщение.Сообщить();
				Продолжить; 
			КонецЕсли;
			
			ОсталосьРаспределить = НужноеКоличество;
			ВыборкаПартия = ВыборкаСтрока.Выбрать();
			
			Пока ВыборкаПартия.Следующий() И ОсталосьРаспределить > 0 Цикл
				Если ВыборкаПартия.СвободныйОстаток <= 0 Тогда Продолжить; КонецЕсли;
				БеремИзПартии = Мин(ОсталосьРаспределить, ВыборкаПартия.СвободныйОстаток);
				
				ДвРасход = Движения.ОстаткиМатериалов.ДобавитьРасход();
				ДвРасход.Период          = Дата;
				ДвРасход.Наименование    = ВыборкаПартия.Номенклатура;
				ДвРасход.Характеристики  = ВыборкаПартия.Характеристика;
				ДвРасход.Счет            = Документы.ЗаказКлиента.ПустаяСсылка();
				ДвРасход.Партия          = ВыборкаПартия.Партия;
				ДвРасход.Остаток         = БеремИзПартии;
				
				ДвПриход = Движения.ОстаткиМатериалов.ДобавитьПриход();
				ДвПриход.Период          = Дата;
				ДвПриход.Наименование    = ВыборкаПартия.Номенклатура;
				ДвПриход.Характеристики  = ВыборкаПартия.Характеристика;
				ДвПриход.Счет            = Ссылка;
				ДвПриход.Партия          = ВыборкаПартия.Партия;
				ДвПриход.Остаток         = БеремИзПартии;
				
				ОсталосьРаспределить     = ОсталосьРаспределить - БеремИзПартии;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	// Сбрасываем новые движения в базу, чтобы виртуальные таблицы остатков их учли
	Движения.ЗаказыРезервы.Записать();
	Движения.ОстаткиМатериалов.Записать();
	Движения.СтадииВыполненияЗаказов.Записать();
	
	// Запускаем движок перераспределения излишков (в случае уменьшения объемов заказа)
	ПерераспределитьИзлишкиИЗаделы();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПерераспределитьИзлишкиИЗаделы()
	
	// Магия алгоритма: если по заказу уже было производство, то после отмены/уменьшения заказа 
	// ресурс "ВЗаявкеОстаток" уйдет в минус. Абсолютная величина этого минуса — это и есть наш излишек!
	
	ГраницаКонтроля = Новый Граница(МоментВремени(), ВидГраницы.Включая);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ТекущийЗаказ", Ссылка);
	Запрос.УстановитьПараметр("Граница",       ГраницаКонтроля);
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Стадии.Номенклатура КАК Номенклатура,
		|	Стадии.Характеристика КАК Характеристика,
		|	-Стадии.ВЗаявкеОстаток КАК КоличествоИзлишек,
		|	ЕСТЬNULL(Стадии.ВПроизводствеОстаток, 0) КАК ВПроизводствеОстаток,
		|	ЕСТЬNULL(Стадии.ГотовоОстаток, 0) КАК ГотовоОстаток
		|ИЗ
		|	РегистрНакопления.СтадииВыполненияЗаказов.Остатки(&Граница, ЗаказКлиента = &ТекущийЗаказ) КАК Стадии
		|ГДЕ
		|	Стадии.ВЗаявкеОстаток < 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Материалы.Наименование КАК Номенклатура,
		|	Материалы.Характеристики КАК Характеристика,
		|	Материалы.Партия КАК Партия,
		|	Материалы.ОстатокОстаток КАК Остаток,
		|	Материалы.СуммаОстаток КАК Сумма
		|ИЗ
		|	РегистрНакопления.ОстаткиМатериалов.Остатки(&Граница, Счет = &ТекущийЗаказ) КАК Материалы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДругиеЗаказы.Номенклатура КАК Номенклатура,
		|	ДругиеЗаказы.Характеристика КАК Характеристика,
		|	ДругиеЗаказы.ЗаказКлиента КАК ЗаказКлиента,
		|	ДругиеЗаказы.ВЗаявкеОстаток КАК Потребность,
		|	ЕСТЬNULL(ДругиеЗаказы.ЗаказКлиента.ДатаОтгрузки, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОтгрузки
		|ИЗ
		|	РегистрНакопления.СтадииВыполненияЗаказов.Остатки(
		|			&Граница,
		|			ЗаказКлиента <> &ТекущийЗаказ
		|				И ЗаказКлиента <> ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
		|		) КАК ДругиеЗаказы
		|ГДЕ
		|	ДругиеЗаказы.ВЗаявкеОстаток > 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаОтгрузки ВОЗР"; // Алгоритм EDD: Срочные заказы в приоритете
		
	РезультатыПакет = Запрос.ВыполнитьПакет();
	
	ТаблицаИзлишков     = РезультатыПакет[0].Выгрузить();
	ТаблицаПартий       = РезультатыПакет[1].Выгрузить();
	ТаблицаПотребностей = РезультатыПакет[2].Выгрузить();
	
	// Если излишков нет — завершаем работу
	Если ТаблицаИзлишков.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Включаем запись для дозаписи корректирующих движений
	Движения.СтадииВыполненияЗаказов.Записывать = Истина;
	Движения.ОстаткиМатериалов.Записывать = Истина;
	
	Для Каждого СтрокаИзлишка Из ТаблицаИзлишков Цикл
		
		ОсталосьРаспределить = СтрокаИзлишка.КоличествоИзлишек;
		КлючНоменклатура     = СтрокаИзлишка.Номенклатура;
		КлючХарактеристика   = СтрокаИзлишка.Характеристика;
		
		ОтборПотребностей = Новый Структура("Номенклатура, Характеристика", КлючНоменклатура, КлючХарактеристика);
		СтрокиПотребностей = ТаблицаПотребностей.НайтиСтроки(ОтборПотребностей);
		
		// ---------------------------------------------------------------------
		// ЭТАП 1: РАСПРЕДЕЛЕНИЕ УЖЕ ГОТОВОЙ ПРОДУКЦИИ (Из статуса "Готово" и склада)
		// ---------------------------------------------------------------------
		ИзлишекГотового = Мин(ОсталосьРаспределить, СтрокаИзлишка.ГотовоОстаток);
		Если ИзлишекГотового > 0 Тогда
			
			ОтборПартий = Новый Структура("Номенклатура, Характеристика", КлючНоменклатура, КлючХарактеристика);
			СтрокиПартий = ТаблицаПартий.НайтиСтроки(ОтборПартий);
			
			ОсталосьГотовогоДляСписания = ИзлишекГотового;
			
			Для Каждого СтрокаПартии Из СтрокиПартий Цикл
				Если ОсталосьГотовогоДляСписания <= 0 Тогда Прервать; КонецЕсли;
				
				БеремИзПартии = Мин(ОсталосьГотовогоДляСписания, СтрокаПартии.Остаток);
				Если БеремИзПартии <= 0 Тогда Продолжить; КонецЕсли;
				
				ДоляСуммы = ?(СтрокаПартии.Остаток = 0, 0, (БеремИзПартии / СтрокаПартии.Остаток) * СтрокаПартии.Сумма);
				
				// А. Списываем готовый товар со своего (отмененного) заказа
				ДвРасходМат = Движения.ОстаткиМатериалов.ДобавитьРасход();
				ДвРасходМат.Период         = Дата;
				ДвРасходМат.Наименование   = КлючНоменклатура;
				ДвРасходМат.Характеристики = КлючХарактеристика;
				ДвРасходМат.Счет           = Ссылка;
				ДвРасходМат.Партия         = СтрокаПартии.Партия;
				ДвРасходМат.Остаток        = БеремИзПартии;
				ДвРасходМат.Сумма          = ДоляСуммы;
				
				ДвРасходСтадия = Движения.СтадииВыполненияЗаказов.ДобавитьРасход();
				ДвРасходСтадия.Период         = Дата;
				ДвРасходСтадия.Номенклатура   = КлючНоменклатура;
				ДвРасходСтадия.Характеристика = КлючХарактеристика;
				ДвРасходСтадия.ЗаказКлиента   = Ссылка;
				ДвРасходСтадия.Готово         = БеремИзПартии;
				
				// Б. Передаем этот объем другим нуждающимся заказам
				ОсталосьПередатьЗаказам = БеремИзПартии;
				Для Каждого СтрокаПотребности Из СтрокиПотребностей Цикл
					Если ОсталосьПередатьЗаказам <= 0 Тогда Прервать; КонецЕсли;
					Если СтрокаПотребности.Потребность <= 0 Тогда Продолжить; КонецЕсли;
					
					ПередаемКоличество = Мин(ОсталосьПередатьЗаказам, СтрокаПотребности.Потребность);
					ТекущаяДоляСуммы   = ?(БеремИзПартии = 0, 0, (ПередаемКоличество / БеремИзПартии) * ДоляСуммы);
					
					// Приходуем под чужой заказ на склад и резервируем
					ДвПриходМат = Движения.ОстаткиМатериалов.ДобавитьПриход();
					ДвПриходМат.Период         = Дата;
					ДвПриходМат.Наименование   = КлючНоменклатура;
					ДвПриходМат.Характеристики = КлючХарактеристика;
					ДвПриходМат.Счет           = СтрокаПотребности.ЗаказКлиента;
					ДвПриходМат.Партия         = СтрокаПартии.Партия;
					ДвПриходМат.Остаток        = ПередаемКоличество;
					ДвПриходМат.Сумма          = ТекущаяДоляСуммы;
					
					// Корректируем цепочку стадий чужого заказа (ВЗаявке -> Готово)
					ДвЧужойРасход = Движения.СтадииВыполненияЗаказов.ДобавитьРасход();
					ДвЧужойРасход.Период         = Дата;
					ДвЧужойРасход.Номенклатура   = КлючНоменклатура;
					ДвЧужойРасход.Характеристика = КлючХарактеристика;
					ДвЧужойРасход.ЗаказКлиента   = СтрокаПотребности.ЗаказКлиента;
					ДвЧужойРасход.ВЗаявке        = ПередаемКоличество;
					
					ДвЧужойПриход = Движения.СтадииВыполненияЗаказов.ДобавитьПриход();
					ДвЧужойПриход.Период         = Дата;
					ДвЧужойПриход.Номенклатура   = КлючНоменклатура;
					ДвЧужойПриход.Характеристика = КлючХарактеристика;
					ДвЧужойПриход.ЗаказКлиента   = СтрокаПотребности.ЗаказКлиента;
					ДвЧужойПриход.Готово         = ПередаемКоличество;
					
					СтрокаПотребности.Потребность = СтрокаПотребности.Потребность - ПередаемКоличество;
					ОсталосьПередатьЗаказам        = ОсталосьПередатьЗаказам - ПередаемКоличество;
				КонецЦикла;
				
				// В. Если никто из заказов товар не забрал — отправляем на свободный склад (unreserved)
				Если ОсталосьПередатьЗаказам > 0 Тогда
					ТекущаяДоляСуммы = ?(БеремИзПартии = 0, 0, (ОсталосьПередатьЗаказам / БеремИзПартии) * ДоляСуммы);
					
					ДвСвободныйМат = Движения.ОстаткиМатериалов.ДобавитьПриход();
					ДвСвободныйМат.Период         = Дата;
					ДвСвободныйМат.Наименование   = КлючНоменклатура;
					ДвСвободныйМат.Характеристики = КлючХарактеристика;
					ДвСвободныйМат.Счет           = Документы.ЗаказКлиента.ПустаяСсылка(); // Свободно
					ДвСвободныйМат.Партия         = СтрокаПартии.Партия;
					ДвСвободныйМат.Остаток        = ОсталосьПередатьЗаказам;
					ДвСвободныйМат.Сумма          = ТекущаяДоляСуммы;
					
					ДвСвободнаяСтадия = Движения.СтадииВыполненияЗаказов.ДобавитьПриход();
					ДвСвободнаяСтадия.Период         = Дата;
					ДвСвободнаяСтадия.Номенклатура   = КлючНоменклатура;
					ДвСвободнаяСтадия.Характеристика = КлючХарактеристика;
					ДвСвободнаяСтадия.ЗаказКлиента   = Документы.ЗаказКлиента.ПустаяСсылка();
					ДвСвободнаяСтадия.Готово         = ОсталосьПередатьЗаказам;
				КонецЕсли;
				
				ОсталосьГотовогоДляСписания = ОсталосьГотовогоДляСписания - БеремИзПартии;
				ОсталосьРаспределить        = ОсталосьРаспределить - БеремИзПартии;
			КонецЦикла;
			
		КонецЕсли;
		
		// ---------------------------------------------------------------------
		// ЭТАП 2: РАСПРЕДЕЛЕНИЕ ОБЪЕМОВ, НАХОДЯЩИХСЯ В ПРОИЗВОДСТВЕ (В цеху)
		// ---------------------------------------------------------------------
		ИзлишекВПроизводстве = Мин(ОсталосьРаспределить, СтрокаИзлишка.ВПроизводствеОстаток);
		Если ИзлишекВПроизводстве > 0 Тогда
			
			// Списываем незавершенку со своего заказа
			ДвРасходПрод = Движения.СтадииВыполненияЗаказов.ДобавитьРасход();
			ДвРасходПрод.Период         = Дата;
			ДвРасходПрод.Номенклатура   = КлючНоменклатура;
			ДвРасходПрод.Характеристика = КлючХарактеристика;
			ДвРасходПрод.ЗаказКлиента   = Ссылка;
			ДвРасходПрод.ВПроизводстве  = ИзлишекВПроизводстве;
			
			ОсталосьПередатьЗаказам = ИзлишекВПроизводстве;
			
			// Ищем, на какие заказы перенаправить открытое производство
			Для Каждого СтрокаПотребности Из СтрокиПотребностей Цикл
				Если ОсталосьПередатьЗаказам <= 0 Тогда Прервать; КонецЕсли;
				Если СтрокаПотребности.Потребность <= 0 Тогда Продолжить; КонецЕсли;
				
				ПередаемКоличество = Мин(ОсталосьПередатьЗаказам, СтрокаПотребности.Потребность);
				
				// Чужой заказ переводим из статуса "ВЗаявке" в статус "ВПроизводстве"
				ДвЧужойРасход = Движения.СтадииВыполненияЗаказов.ДобавитьРасход();
				ДвЧужойРасход.Период         = Дата;
				ДвЧужойРасход.Номенклатура   = КлючНоменклатура;
				ДвЧужойРасход.Характеристика = КлючХарактеристика;
				ДвЧужойРасход.ЗаказКлиента   = СтрокаПотребности.ЗаказКлиента;
				ДвЧужойРасход.ВЗаявке        = ПередаемКоличество;
				
				ДвЧужойПриход = Движения.СтадииВыполненияЗаказов.ДобавитьПриход();
				ДвЧужойПриход.Период         = Дата;
				ДвЧужойПриход.Номенклатура   = КлючНоменклатура;
				ДвЧужойПриход.Характеристика = КлючХарактеристика;
				ДвЧужойПриход.ЗаказКлиента   = СтрокаПотребности.ЗаказКлиента;
				ДвЧужойПриход.ВПроизводстве  = ПередаемКоличество;
				
				СтрокаПотребности.Потребность = СтрокаПотребности.Потребность - ПередаемКоличество;
				ОсталосьПередатьЗаказам        = ОсталосьПередатьЗаказам - ПередаемКоличество;
			КонецЦикла;
			
			// Если заказов больше нет — производство продолжается на свободный склад
			Если ОсталосьПередатьЗаказам > 0 Тогда
				ДвСвободнаяПрод = Движения.СтадииВыполненияЗаказов.ДобавитьПриход();
				ДвСвободнаяПрод.Период         = Дата;
				ДвСвободнаяПрод.Номенклатура   = КлючНоменклатура;
				ДвСвободнаяПрод.Характеристика = КлючХарактеристика;
				ДвСвободнаяПрод.ЗаказКлиента   = Документы.ЗаказКлиента.ПустаяСсылка();
				ДвСвободнаяПрод.ВПроизводстве  = ОсталосьПередатьЗаказам;
			КонецЕсли;
			
			ОсталосьРаспределить = ОсталосьРаспределить - ИзлишекВПроизводстве;
		КонецЕсли;
		
		// ---------------------------------------------------------------------
		// ЭТАП 3: ЗАКРЫТИЕ ОТРИЦАТЕЛЬНОГО БАЛАНСА ТЕКУЩЕГО ЗАКАЗА
		// ---------------------------------------------------------------------
		// Делаем компенсирующий Приход "ВЗаявке", чтобы вывести итоговый баланс 
		// нашего измененного/отмененного заказа ровно в ноль.
		ДвЗакрытиеВЗаявке = Движения.СтадииВыполненияЗаказов.ДобавитьПриход();
		ДвЗакрытиеВЗаявке.Период         = Дата;
		ДвЗакрытиеВЗаявке.Номенклатура   = КлючНоменклатура;
		ДвЗакрытиеВЗаявке.Характеристика = КлючХарактеристика;
		ДвЗакрытиеВЗаявке.ЗаказКлиента   = Ссылка;
		ДвЗакрытиеВЗаявке.ВЗаявке        = СтрокаИзлишка.КоличествоИзлишек;
		
	КонецЦикла;

КонецПроцедуры

#КонецОбласти