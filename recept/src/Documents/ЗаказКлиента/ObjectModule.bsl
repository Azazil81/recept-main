
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
   
	// 1. Подготавливаем движения
	Движения.ОстаткиМатериалов.Записывать = Истина;
	Движения.ЗаказыРезервы.Записывать = Истина;
    
    // 2. Очищаем старые движения (если документ перепроводится)
    Движения.ОстаткиМатериалов.Очистить();
    Движения.ЗаказыРезервы.Очистить();
    
    // 3. Подготовка данных: выгружаем ТЧ в таблицу для запроса
    ТаблицаТоваров = Товары.Выгрузить();
    
    // 4. Блокировка данных для предотвращения параллельного списания
    Блокировка = Новый БлокировкаДанных;
    ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ОстаткиМатериалов");
    ЭлементБлокировки.ИсточникДанных = ТаблицаТоваров;
    ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Наименование", "Номенклатура");
    ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Характеристики", "Характеристика");
    ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ВходнойКонтроль", "ВходнойКонтроль");
    ЭлементБлокировки.УстановитьЗначение("Счет", Документы.ЗаказКлиента.ПустаяСсылка());
    ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
    
    // 5. ЕДИНЫЙ ЗАПРОС (ВТ + Остатки)
    Запрос = Новый Запрос;
    Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |	ТчТовары.Номенклатура КАК Номенклатура,
        |	ТчТовары.ХарактеристикиНоменклатуры КАК Характеристика,
        |	ТчТовары.Количество КАК КоличествоНужно,
        |	ТчТовары.ВариантОбеспеченияПоставки КАК ВариантОбеспечения,
        |	ТчТовары.НомерСтроки КАК НомерСтрокиТч,
        |	ТчТовары.ВходнойКонтроль КАК ВходнойКонтроль
        |ПОМЕСТИТЬ ВТ_Нужды
        |ИЗ
        |	&ТаблицаТоваров КАК ТчТовары
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ
        |	ВТ.Номенклатура,
        |	ВТ.Характеристика,
        |	ВТ.КоличествоНужно,
        |	ВТ.ВариантОбеспечения,
        |	ВТ.НомерСтрокиТч,
        |	ВТ.ВходнойКонтроль,
        |	ЕСТЬNULL(Остатки.Партия, ЗНАЧЕНИЕ(Документ.ВыпускПродукции.ПустаяСсылка)) КАК Партия,
        |	ЕСТЬNULL(Остатки.ОстатокОстаток, 0) КАК СвободныйОстаток
        |ИЗ
        |	ВТ_Нужды КАК ВТ
        |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиМатериалов.Остатки(
        |				&Период,
        |				(Наименование, Характеристики, ВходнойКонтроль) В
        |						(ВЫБРАТЬ
        |							ВТ_Нужды.Номенклатура,
        |							ВТ_Нужды.Характеристика,
        |						    ВТ_Нужды.ВходнойКонтроль
        |						ИЗ
        |							ВТ_Нужды)
        |					И Счет = &ПустойСчет) КАК Остатки
        |		ПО ВТ.Номенклатура = Остатки.Наименование
        |			И ВТ.Характеристика = Остатки.Характеристики
        |			И ВТ.ВходнойКонтроль = Остатки.ВходнойКонтроль
        |ИТОГИ
        |	МАКСИМУМ(КоличествоНужно),
        |	СУММА(СвободныйОстаток),
        |	МАКСИМУМ(Номенклатура),
        |	МАКСИМУМ(Характеристика),
        |	МАКСИМУМ(Вт.ВходнойКонтроль),
        |	МАКСИМУМ(ВариантОбеспечения)
        |ПО
        |	НомерСтрокиТч"; // Группируем по строке ТЧ, чтобы обработать каждую позицию отдельно

    Запрос.УстановитьПараметр("ТаблицаТоваров", ТаблицаТоваров);
    Запрос.УстановитьПараметр("Период",         Новый Граница(МоментВремени(), ВидГраницы.Исключая));
    Запрос.УстановитьПараметр("ПустойСчет",     Документы.ЗаказКлиента.ПустаяСсылка());

    РезультатЗапроса = Запрос.Выполнить();
  
    
    // 4. ОБХОД РЕЗУЛЬТАТОВ (Иерархия: Строка ТЧ -> Партии)
    ВыборкаСтрока = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
    
    Пока ВыборкаСтрока.Следующий() Цикл
        
        НужноеКоличество = ВыборкаСтрока.КоличествоНужно;
        СвободныйОстатокОбщий = ВыборкаСтрока.СвободныйОстаток;
        
        // 5. Проверка остатков на складе для варианта "РЕЗЕРВ"
		Если ВыборкаСтрока.ВариантОбеспечения = Перечисления.ВариантОбеспеченияПоставки.Резерв Тогда
            
            Если НужноеКоличество > СвободныйОстатокОбщий Тогда
                
                Отказ = Истина; // Прерываем проведение
                
                // Сообщаем пользователю, чего именно не хватило
                Сообщение = Новый СообщениеПользователю;
                Дефицит = НужноеКоличество - СвободныйОстатокОбщий;
                Сообщение.Текст = СтрШаблон(
                    "Строка %1: Недостаточно товара '%2' (%3). Требуется: %4, В наличии: %5. Дефицит: %6",
                    ВыборкаСтрока.НомерСтрокиТч,
                    ВыборкаСтрока.Номенклатура,
                    ВыборкаСтрока.Характеристика,
                    НужноеКоличество,
                    СвободныйОстатокОбщий,
                    Дефицит
                );
                // Привязываем сообщение к конкретному полю в табличной части
                Сообщение.Поле = СтрШаблон("Товары[%1].Количество", ВыборкаСтрока.НомерСтрокиТч - 1);
                Сообщение.УстановитьДанные(ЭтотОбъект);
                Сообщение.Сообщить();
                
                Продолжить; // Переходим к следующей строке, чтобы собрать все ошибки
            КонецЕсли;
            
        КонецЕсли;        
        
        КоличествоВРезерв = 0;
        КоличествоВПроизводство = 0;
        
        // Математика распределения
        Если ВыборкаСтрока.ВариантОбеспечения = Перечисления.ВариантОбеспеченияПоставки.ТолькоПроизводство Тогда
            КоличествоВПроизводство = НужноеКоличество;
		ИначеЕсли ВыборкаСтрока.ВариантОбеспечения = Перечисления.ВариантОбеспеченияПоставки.Резерв Тогда
            КоличествоВРезерв = НужноеКоличество;
        Иначе 
            КоличествоВРезерв = Мин(НужноеКоличество, СвободныйОстатокОбщий);
            КоличествоВПроизводство = НужноеКоличество - КоличествоВРезерв;
        КонецЕсли;
        
        // Резервируем из партий
        Если Не Отказ И КоличествоВРезерв > 0 Тогда
            ОсталосьРаспределить = КоличествоВРезерв;
            
            ВыборкаПартия = ВыборкаСтрока.Выбрать();
            Пока ВыборкаПартия.Следующий() И ОсталосьРаспределить > 0 Цикл
                
                Если ВыборкаПартия.СвободныйОстаток <= 0 Тогда Продолжить; КонецЕсли;
                
                БеремИзПартии = Мин(ОсталосьРаспределить, ВыборкаПартия.СвободныйОстаток);
                
                // Расход из свободных
                ДвРасход = Движения.ОстаткиМатериалов.ДобавитьРасход();
                ДвРасход.Период         = Дата;
                ДвРасход.Наименование   = ВыборкаПартия.Номенклатура;
                ДвРасход.Характеристики = ВыборкаПартия.Характеристика;
                ДвРасход.Счет           = Документы.ЗаказКлиента.ПустаяСсылка();
                ДвРасход.Партия         = ВыборкаПартия.Партия;
                ДвРасход.ВходнойКонтроль = ВыборкаПартия.ВходнойКонтроль;
                ДвРасход.Остаток     	= БеремИзПартии;
                
                // Приход в резерв
                ДвПриход = Движения.ОстаткиМатериалов.ДобавитьПриход();
                ДвПриход.Период         = Дата;
                ДвПриход.Наименование   = ВыборкаПартия.Номенклатура;
                ДвПриход.Характеристики = ВыборкаПартия.Характеристика;
                ДвПриход.Счет           = Ссылка;
                ДвПриход.Партия         = ВыборкаПартия.Партия;
                ДвПриход.ВходнойКонтроль = ВыборкаПартия.ВходнойКонтроль;
                ДвПриход.Остаток     	= БеремИзПартии;
                
                ОсталосьРаспределить 	= ОсталосьРаспределить - БеремИзПартии;
            КонецЦикла;
        КонецЕсли;
 
         Если Не Отказ И КоличествоВПроизводство > 0 Тогда
            ДвЗаказы = Движения.ЗаказыРезервы.ДобавитьПриход();
            ДвЗаказы.Период         = Дата;
            ДвЗаказы.Счет           = Ссылка;
            ДвЗаказы.Номенклатура   = ВыборкаСтрока.Номенклатура;
            ДвЗаказы.Характеристики = ВыборкаСтрока.Характеристика;
            ДвЗаказы.ВходнойКонтроль= ВыборкаСтрока.ВходнойКонтроль;
            ДвЗаказы.Количество     = КоличествоВПроизводство;
        КонецЕсли;
        
    КонецЦикла;

КонецПроцедуры
