#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

// При ручном добавлении новой строки по умолчанию ставим Производство = Истина
&НаКлиенте
Процедура ТоварыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	Если НоваяСтрока И Не Копирование Тогда
			Элемент.ТекущиеДанные.Производство = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	
	СтрокаТЧ = Элементы.Товары.ТекущиеДанные;
    Если СтрокаТЧ = Неопределено Тогда Возврат; КонецЕсли;

    РассчитатьСтроку(СтрокаТЧ);

КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)
	
	СтрокаТЧ = Элементы.Товары.ТекущиеДанные;
    Если СтрокаТЧ = Неопределено Тогда Возврат; КонецЕсли;
    
    РассчитатьСтроку(СтрокаТЧ);

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПартияПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Управляем флагом "Производство" (Булево):
	// Если Партия заполнена — ЗначениеЗаполнено() вернет Истина, а "НЕ" превратит её в Ложь.
	// Если Партия очищена — ЗначениеЗаполнено() вернет Ложь, а "НЕ" превратит её в Истина.
	ТекущиеДанные.Производство = Не ЗначениеЗаполнено(ТекущиеДанные.Партия);
	
	
	// --- (Ниже сохраняем логику автозаполнения характеристики и номенклатуры  из партии) ---
	Если ЗначениеЗаполнено(ТекущиеДанные.Партия) Тогда
		ХарактеристикаВладелец 	= ПолучениеДанныхНоменклатуры.ПолучитьВладельцаПартии(ТекущиеДанные.Партия);
		НоменклатураВладелец 	= ПолучениеДанныхНоменклатуры.ПолучитьВладельцаХарактеристики(ХарактеристикаВладелец);
		Если ЗначениеЗаполнено(ХарактеристикаВладелец) Тогда
			ТекущиеДанные.Характеристика 	= ХарактеристикаВладелец;
			ТекущиеДанные.Номенклатура 		= НоменклатураВладелец;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура ТоварыПослеУдаления(Элемент)
	
	// Если строку удалили, общий итог должен уменьшиться
	РассчитатьИтогДокумента();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РассчитатьСтроку(СтрокаТЧ)
	Если СтрокаТЧ <> Неопределено Тогда   
	
	    СтрокаТЧ.Сумма = СтрокаТЧ.Количество * СтрокаТЧ.Цена;
	    
	    СтрокаТЧ.НДССтавка = ПолучитьСтавкуНДСНаСервере();
	    
	    // НДС "сверху"
	    СтрокаТЧ.НДС = СтрокаТЧ.Сумма * СтрокаТЧ.НДССтавка / 100;
	    
	    СтрокаТЧ.ВсегоСНДС = СтрокаТЧ.Сумма + СтрокаТЧ.НДС;

		// После расчета строки сразу обновляем общий итог в шапке
		РассчитатьИтогДокумента();
		
	КонецЕсли;
    
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьИтогДокумента()
	
	// Метод Итог() на клиенте работает быстро и без серверных вызовов
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма");
	
КонецПроцедуры

// =====================================================================
// СЕРВЕРНЫЕ ФУНКЦИИ БЕЗ КОНТЕКСТА 
// (Остаются без изменений, логика полностью актуальна)
// =====================================================================

&НаСервереБезКонтекста
Функция ПолучитьСтавкуНДСНаСервере()
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |    СтавкаНДСТовар.Ставка КАК Ставка
        |ИЗ
        |    РегистрСведений.СтавкаНДСТовар КАК СтавкаНДСТовар";
        
    Результат = Запрос.Выполнить();
    
    Если Не Результат.Пустой() Тогда
        Выборка = Результат.Выбрать();
        Выборка.Следующий();
        Возврат Выборка.Ставка;
    КонецЕсли;
    
    Возврат 0; 
    
КонецФункции

#КонецОбласти