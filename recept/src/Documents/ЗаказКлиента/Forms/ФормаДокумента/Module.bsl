#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РассчитатьСтроку(СтрокаТЧ)
    
    СтрокаТЧ.Сумма = СтрокаТЧ.Количество * СтрокаТЧ.Цена;
    
    СтрокаТЧ.НДССтавка = ПолучитьСтавкуНДСНаСервере();
    
    // НДС "сверху"
    СтрокаТЧ.НДС = СтрокаТЧ.Сумма * СтрокаТЧ.НДССтавка / 100;
    
    СтрокаТЧ.ВсегоСНДС = СтрокаТЧ.Сумма + СтрокаТЧ.НДС;
    
КонецПроцедуры

// =====================================================================
// СЕРВЕРНЫЕ ФУНКЦИИ БЕЗ КОНТЕКСТА 
// (Остаются без изменений, логика полностью актуальна)
// =====================================================================

&НаСервереБезКонтекста
Функция ПолучитьСтавкуНДСНаСервере()
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |    СтавкаНДСТовар.Ставка КАК Ставка
        |ИЗ
        |    РегистрСведений.СтавкаНДСТовар КАК СтавкаНДСТовар";
        
    Результат = Запрос.Выполнить();
    
    Если Не Результат.Пустой() Тогда
        Выборка = Результат.Выбрать();
        Выборка.Следующий();
        Возврат Выборка.Ставка;
    КонецЕсли;
    
    Возврат 0; 
    
КонецФункции

#КонецОбласти