
#Область СлужебныеПроцедурыНаСервере

&НаСервереБезКонтекста
Функция ПолучитьЕдИзмМатериала(Материал)
	Возврат Материал.ЕдиницаИзмеренияСырья;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьНаименованиеМатериала(Материал)
	Возврат Материал.Наименование;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьТипМатериала(Материал)
	Возврат Материал.ТипНоменклатуры;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьНомерСчета(Счет)
	Возврат Счет.Номер;
КонецФункции

&НаСервере
Процедура ЗаполнитьОстаткиИВПроизводствеНаСервере()
	
	СписокМатериалов = Новый Массив;
	Для каждого СтрокаТЧ Из Объект.РецептураСостав Цикл
		Если СписокМатериалов.Найти(СтрокаТЧ.Материал) = Неопределено Тогда
			СписокМатериалов.Добавить(СтрокаТЧ.Материал);
		КонецЕсли;
	КонецЦикла;
	
	ДанныеОстатков = РаботаСоСправочниками.ОстаткиИВПроизводстве(Объект.Ссылка, СписокМатериалов);
	
	ОстатокСписания = Новый Соответствие;
	Для каждого КлючЗначение Из ДанныеОстатков Цикл
		ОстатокСписания.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение.ВПроизводстве);
	КонецЦикла;
	
	Для каждого СтрокаТЧ Из Объект.РецептураСостав Цикл
		ДанныеМатериала = ДанныеОстатков.Получить(СтрокаТЧ.Материал);
		Если ДанныеМатериала <> Неопределено Тогда
			СтрокаТЧ.Остаток = ДанныеМатериала.Остаток;
		Иначе
			СтрокаТЧ.Остаток = 0;
		КонецЕсли;
		
		Доступно = ОстатокСписания.Получить(СтрокаТЧ.Материал);
		Если Доступно = Неопределено Тогда
			Доступно = 0;
		КонецЕсли;
		
		НаСтроку = Мин(Доступно, СтрокаТЧ.ТребуетсяДляПроизводства);
		СтрокаТЧ.ВПроизводстве = НаСтроку;
		ОстатокСписания.Вставить(СтрокаТЧ.Материал, Доступно - НаСтроку);
		
		СтрокаТЧ.Потребность = СтрокаТЧ.ТребуетсяДляПроизводства - СтрокаТЧ.ВПроизводстве;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыНаКлиенте

&НаКлиенте
Процедура ОбновитьСтатусЗагрузки()
	
	Если Объект.Лабораторная Тогда
		Возврат;
	КонецЕсли;
	
	ИтогТребуется = Объект.РецептураСостав.Итог("ТребуетсяДляПроизводства");
	ИтогВПроизводстве = Объект.РецептураСостав.Итог("ВПроизводстве");
	
	Если ИтогТребуется > 0 И ИтогВПроизводстве > 0 Тогда
		Если ИтогТребуется > ИтогВПроизводстве Тогда
			Объект.СтатусЗагрузки = ПредопределенноеЗначение("Перечисление.СостояниеЗагрузкиСырьяПроизводства.ЧастичноОбеспечено");
		ИначеЕсли ИтогТребуется = ИтогВПроизводстве Тогда
			Объект.СтатусЗагрузки = ПредопределенноеЗначение("Перечисление.СостояниеЗагрузкиСырьяПроизводства.Обеспечено");
		Иначе
			Объект.СтатусЗагрузки = ПредопределенноеЗначение("Перечисление.СостояниеЗагрузкиСырьяПроизводства.Перегруз");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусВыпуска()
	
	ИтогКоличество = Объект.Продукция.Итог("Количество");
	ИтогВыпущено = Объект.Продукция.Итог("Выпущено");
	
	Если ИтогКоличество > 0 И ИтогВыпущено > 0 Тогда
		Если ИтогКоличество > ИтогВыпущено Тогда
			Объект.СтатусВыпуска = ПредопределенноеЗначение("Перечисление.СостояниеВыпускаПродукции.ЧастичноВыпущена");
		ИначеЕсли ИтогКоличество = ИтогВыпущено Тогда
			Объект.СтатусВыпуска = ПредопределенноеЗначение("Перечисление.СостояниеВыпускаПродукции.Выпущена");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьЗагрузкуПоКомпонентам(ИмяПоля)
	
	Объект.ЗагрузкаНаТонну1 = 0;
	Объект.ЗагрузкаНаТонну2 = 0;
	Объект.ЗагрузкаНаТонну3 = 0;
	Объект.ЗагрузкаНаТонну4 = 0;
	
	Компонент = 1;
	
	Для каждого Строка Из Объект.РецептураСостав Цикл
		
		Наименование = ПолучитьНаименованиеМатериала(Строка.Материал);
		
		Если Наименование = "Компонент 2" Тогда
			Компонент = 2;
		ИначеЕсли Наименование = "Компонент 3" Тогда
			Компонент = 3;
		ИначеЕсли Наименование = "Компонент 4" Тогда
			Компонент = 4;
		КонецЕсли;
		
		Если Строка.ЕдиницаИзмеренияЗагрузки <> "кг" Тогда
			Продолжить;
		КонецЕсли;
		
		Если ИмяПоля = "ТребуетсяДляПроизводства" Тогда
			Значение = Строка.ТребуетсяДляПроизводства;
		Иначе
			Значение = Строка.КоличествоНаТонну;
		КонецЕсли;
		
		Если Компонент = 1 Тогда
			Объект.ЗагрузкаНаТонну1 = Объект.ЗагрузкаНаТонну1 + Значение;
		ИначеЕсли Компонент = 2 Тогда
			Объект.ЗагрузкаНаТонну2 = Объект.ЗагрузкаНаТонну2 + Значение;
		ИначеЕсли Компонент = 3 Тогда
			Объект.ЗагрузкаНаТонну3 = Объект.ЗагрузкаНаТонну3 + Значение;
		Иначе
			Объект.ЗагрузкаНаТонну4 = Объект.ЗагрузкаНаТонну4 + Значение;
		КонецЕсли;
		
	КонецЦикла;
	
	Объект.ЗагрузкаИтого = Объект.ЗагрузкаНаТонну1 + Объект.ЗагрузкаНаТонну2
		+ Объект.ЗагрузкаНаТонну3 + Объект.ЗагрузкаНаТонну4;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСтоимостьПроизводства()
	Объект.ОбщаяСтоимостьПроизводства = Объект.РецептураСостав.Итог("Сумма")
		+ Объект.Переработка * Объект.ТребуемоеКоличество * 0.001;
	Объект.ЦенаЗаКг = Объект.ОбщаяСтоимостьПроизводства / Объект.ТребуемоеКоличество;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриЧтенииНаСервере0(ТекущийОбъект)
	Если ТекущийОбъект.Проведен
			И Объект.СтатусЗагрузки = Перечисления.СостояниеЗагрузкиСырьяПроизводства.Обеспечено
			И Объект.СтатусВыпуска = Перечисления.СостояниеВыпускаПродукции.Выпущена Тогда
		ЭтаФорма.ТолькоПросмотр = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Для каждого Строка Из Объект.Продукция Цикл
		Строка.СостояниеОбеспечения = РаботаСоСправочниками.СтатусМатериала(Строка.Наименование);
		Строка.Выпущено = РаботаСоСправочниками.ВыпускПродукции(Объект.Ссылка, Строка.Наименование);
	КонецЦикла;
	
	ОбновитьСтатусВыпуска();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	Оповестить("Документ.Производство.Проведен", Объект.Ссылка, ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Документ.СпиасниеВПроизводство.Проведен" Тогда
		
		ЗаполнитьОстаткиИВПроизводствеНаСервере();
		
		Для каждого Строка Из Объект.РецептураСостав Цикл
			Если Строка.Действие = ПредопределенноеЗначение("Перечисление.СостояниеОбеспечения.Отгрузить")
					И Строка.ВПроизводстве >= Строка.ТребуетсяДляПроизводства Тогда
				Строка.Действие = ПредопределенноеЗначение("Перечисление.СостояниеОбеспечения.Отгружен");
			КонецЕсли;
		КонецЦикла;
		
		ОбновитьСтатусЗагрузки();
		
	ИначеЕсли ИмяСобытия = "Документ.ВыпускПродукции.Проведен" Тогда
		
		Для каждого Строка Из Объект.Продукция Цикл
			Строка.СостояниеОбеспечения = РаботаСоСправочниками.СтатусМатериала(Строка.Наименование);
			Строка.Выпущено = РаботаСоСправочниками.ВыпускПродукции(Объект.Ссылка, Строка.Наименование);
		КонецЦикла;
		
		ОбновитьСтатусВыпуска();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Для Каждого Строка Из ВыбранноеЗначение Цикл
		Если Строка.Выбор Тогда
			НоваяСтрока = Объект.Продукция.Добавить();
			НоваяСтрока.Наименование = Строка.Номенклатура;
			НоваяСтрока.Количество = Строка.Количество;
			НоваяСтрока.СостояниеОбеспечения = ПредопределенноеЗначение("Перечисление.СтатусыГотовностиПродукции.ВРаботе");
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиСобытийШапки

&НаКлиенте
Процедура ТребуемоеКоличествоПриИзменении(Элемент)
	
	Если Объект.ТребуемоеКоличество <= 0 Тогда
		Сообщить("Нельзя произвести " + Объект.ТребуемоеКоличество + " кг");
		Возврат;
	КонецЕсли;
	
	Для каждого Строка Из Объект.РецептураСостав Цикл
		Строка.ТребуетсяДляПроизводства = ОКР(Строка.КоличествоНаТонну * 0.001 * Объект.ТребуемоеКоличество + 0.999, 0, РежимОкругления.Окр15как10);
		Строка.ЕдиницаИзмеренияЗагрузки = ПолучитьЕдИзмМатериала(Строка.Материал);
		Строка.Цена = РаботаСоСправочниками.ЦенаМатериалов(ТекущаяДата(), Строка.Материал);
		Строка.Сумма = Строка.ТребуетсяДляПроизводства * Строка.Цена;
	КонецЦикла;
	
	ЗаполнитьОстаткиИВПроизводствеНаСервере();
	РассчитатьЗагрузкуПоКомпонентам("ТребуетсяДляПроизводства");
	РассчитатьСтоимостьПроизводства();
	ОбновитьСтатусЗагрузки();
	
КонецПроцедуры

&НаКлиенте
Процедура ПереработкаПриИзменении(Элемент)
	РассчитатьСтоимостьПроизводства();
КонецПроцедуры

&НаКлиенте
Процедура ЛабораторнаяПриИзменении(Элемент)
	Если Объект.Лабораторная Тогда
		Объект.СтатусЗагрузки = ПредопределенноеЗначение("Перечисление.СостояниеЗагрузкиСырьяПроизводства.Обеспечено");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТЧРецептураСостав

&НаКлиенте
Процедура РецептураСоставПриАктивизацииСтроки(Элемент)
	
	ЗаполнитьОстаткиИВПроизводствеНаСервере();
	
	Для каждого Строка Из Объект.РецептураСостав Цикл
		Если Строка.ВПроизводстве = Строка.ТребуетсяДляПроизводства Тогда
			Строка.Действие = ПредопределенноеЗначение("Перечисление.СостояниеОбеспечения.Отгружен");
		КонецЕсли;
	КонецЦикла;
	
	ОбновитьСтатусЗагрузки();
	
КонецПроцедуры

&НаКлиенте
Процедура РецептураСоставПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока И НЕ Копирование Тогда
		Элемент.ТекущиеДанные.Действие = ПредопределенноеЗначение("Перечисление.СостояниеОбеспечения.КОбеспечению");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РецептураСоставМатериалПриИзменении(Элемент)
	
	ТекДанные = Элементы.РецептураСостав.ТекущиеДанные;
	
	ТекДанные.Остаток = РаботаСоСправочниками.ОстаткиМатериалов(ТекДанные.Материал);
	ТекДанные.Цена = РаботаСоСправочниками.ЦенаМатериалов(ТекущаяДата(), ТекДанные.Материал);
	
	ОбновитьСтатусЗагрузки();
	
	Если ПолучитьТипМатериала(ТекДанные.Материал) = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Продукция") Тогда
		Объект.ЕстьПродукция = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РецептураСоставКоличествоНаТоннуПриИзменении(Элемент)
	
	ТекДанные = Элементы.РецептураСостав.ТекущиеДанные;
	ТекДанные.ТребуетсяДляПроизводства = ТекДанные.КоличествоНаТонну * 0.001 * Объект.ТребуемоеКоличество;
	
	ЗаполнитьОстаткиИВПроизводствеНаСервере();
	ОбновитьСтатусЗагрузки();
	
КонецПроцедуры

&НаКлиенте
Процедура РецептураСоставТребуетсяДляПроизводстваПриИзменении(Элемент)
	
	ТекДанные = Элементы.РецептураСостав.ТекущиеДанные;
	
	ТекДанные.КоличествоНаТонну = ТекДанные.ТребуетсяДляПроизводства * 1000 / Объект.ТребуемоеКоличество;
	ТекДанные.Сумма = ТекДанные.ТребуетсяДляПроизводства * РаботаСоСправочниками.ЦенаМатериалов(ТекущаяДата(), ТекДанные.Материал);
	ТекДанные.ЕдиницаИзмеренияЗагрузки = ПолучитьЕдИзмМатериала(ТекДанные.Материал);
	
	ЗаполнитьОстаткиИВПроизводствеНаСервере();
	
	Если (ТекДанные.Действие = ПредопределенноеЗначение("Перечисление.СостояниеОбеспечения.Отгружен")
			ИЛИ ТекДанные.Действие = ПредопределенноеЗначение("Перечисление.СостояниеОбеспечения.Отгрузить"))
			И ТекДанные.ТребуетсяДляПроизводства > ТекДанные.ВПроизводстве Тогда
		ТекДанные.Действие = ПредопределенноеЗначение("Перечисление.СостояниеОбеспечения.КОбеспечению");
	КонецЕсли;
	
	РассчитатьЗагрузкуПоКомпонентам("КоличествоНаТонну");
	РассчитатьСтоимостьПроизводства();
	ОбновитьСтатусЗагрузки();
	
КонецПроцедуры

&НаКлиенте
Процедура РецептураСоставДействиеПриИзменении(Элемент)
	
	ТекДанные = Элементы.РецептураСостав.ТекущиеДанные;
	
	Если ТекДанные.Остаток + ТекДанные.ВПроизводстве < ТекДанные.ТребуетсяДляПроизводства Тогда
		ТекДанные.Действие = ПредопределенноеЗначение("Перечисление.СостояниеОбеспечения.КОбеспечению");
		Сообщить("Нельзя обеспечить " + ТекДанные.ТребуетсяДляПроизводства + " кг. Недостаточно на складе.");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТЧПродукция

&НаКлиенте
Процедура Продукция1НаименованиеПриИзменении(Элемент)
	ТекДанные = Элементы.Продукция1.ТекущиеДанные;
	ТекДанные.СостояниеОбеспечения = ПредопределенноеЗначение("Перечисление.СтатусыГотовностиПродукции.ВРаботе");
	ОбновитьСтатусВыпуска();
КонецПроцедуры

&НаКлиенте
Процедура Продукция1КоличествоПриИзменении(Элемент)
	
	Для каждого Строка Из Объект.Продукция Цикл
		Строка.Выпущено = РаботаСоСправочниками.ВыпускПродукции(Объект.Ссылка, Строка.Наименование);
	КонецЦикла;
	
	ОбновитьСтатусВыпуска();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТЧСчета

&НаКлиенте
Процедура СчетаСчетПриИзменении(Элемент)
	ТекДанные = Элементы.Счета.ТекущиеДанные;
	Форма = ПолучитьФорму("Документ.Рецептуры.Форма.ФормаПодбораПродукции", , ЭтотОбъект);
	Форма.Счет = ТекДанные.Счет;
	Форма.ОткрытьМодально();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКоманд

&НаКлиенте
Процедура Отгрузить(Команда)
	
	ЗаполнитьОстаткиИВПроизводствеНаСервере();
	
	СтатусКОбеспечению = ПредопределенноеЗначение("Перечисление.СостояниеОбеспечения.КОбеспечению");
	СтатусОтгрузить = ПредопределенноеЗначение("Перечисление.СостояниеОбеспечения.Отгрузить");
	СтатусОтгружен = ПредопределенноеЗначение("Перечисление.СостояниеОбеспечения.Отгружен");
	ЕдИзмКг = ПредопределенноеЗначение("Перечисление.ЕдиницыИзмерения.Килограмм");
	
	Для каждого Строка Из Объект.РецептураСостав Цикл
		
		ФактНаличие = Строка.Остаток + Строка.ВПроизводстве;
		
		Если Строка.Действие = СтатусКОбеспечению
				И ФактНаличие >= Строка.ТребуетсяДляПроизводства
				И ЕдИзмКг = ПолучитьЕдИзмМатериала(Строка.Материал) Тогда
			Строка.Действие = СтатусОтгрузить;
		ИначеЕсли Строка.Действие = СтатусОтгрузить
				И Строка.ВПроизводстве = Строка.ТребуетсяДляПроизводства Тогда
			Строка.Действие = СтатусОтгружен;
		КонецЕсли;
		
	КонецЦикла;
	
	ОбновитьСтатусЗагрузки();
	
КонецПроцедуры

&НаКлиенте
Процедура Документы(Команда)
	УсловияОтбора = Новый Структура("ДокументОснование", Объект.Ссылка);
	ПараметрыФормы = Новый Структура("Отбор, СформироватьПриОткрытии", УсловияОтбора, Истина);
	ОткрытьФорму("Отчет.ДокументыСписанияСырьяВПроизводство.Форма", ПараметрыФормы);
КонецПроцедуры

#КонецОбласти
