
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
        ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// 1. Инициализация и очистка движений
	Движения.СтадииВыполненияЗаказов.Записывать = Истина;
	Движения.СтадииВыполненияЗаказов.Очистить();
	
	// Блокировка данных для исключения конкурентного списания
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.СтадииВыполненияЗаказов");
	ЭлементБлокировки.УстановитьЗначение("Номенклатура", Номенклатура);
	ЭлементБлокировки.УстановитьЗначение("Характеристика", Характеристика);
	Блокировка.Заблокировать();
	
	// 2. Запрос остатков по ФИФО (сортировка по дате документа-заказа)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Остатки.ЗаказКлиента КАК ЗаказКлиента,
		|	Остатки.ВЗаявкеОстаток КАК ВЗаявкеОстаток
		|ИЗ
		|	РегистрНакопления.СтадииВыполненияЗаказов.Остатки(
		|		&МоментВремени,
		|		Номенклатура = &Номенклатура
		|			И Характеристика = &Характеристика
		|	) КАК Остатки
		|ГДЕ
		|	Остатки.ВЗаявкеОстаток > 0
		|УПОРЯДОЧИТЬ ПО
		|	Остатки.ЗаказКлиента.Дата ВОЗР"; // Сортировка ФИФО
		
	Запрос.УстановитьПараметр("МоментВремени",  МоментВремени());
	Запрос.УстановитьПараметр("Номенклатура",   Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Характеристика);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	// Если заявок нет, а производство проводится (перепроизводство разрешено по ТЗ)
	Если РезультатЗапроса.Пустой() Тогда
		// Оформляем как производство без заказа
		Движение = Движения.СтадииВыполненияЗаказов.ДобавитьПриход();
		Движение.Период         = Дата;
		Движение.Номенклатура   = Номенклатура;
		Движение.Характеристика = Характеристика;
		Движение.ЗаказКлиента   = Документы.ЗаказКлиента.ПустаяСсылка();
		Движение.ВПроизводстве  = Количество;
		Возврат;
	КонецЕсли;
	
	ОсталосьРаспределить = Количество;
	Выборка = РезультатЗапроса.Выбрать();
	
	// 3. Распределение по заказам
	Пока Выборка.Следующий() И ОсталосьРаспределить > 0 Цикл
		
		РаспределяемНаЗаказ = Мин(ОсталосьРаспределить, Выборка.ВЗаявкеОстаток);
		
		// Минусуем стадию "ВЗаявке"
		ДвижениеРасход = Движения.СтадииВыполненияЗаказов.ДобавитьРасход();
		ДвижениеРасход.Период        = Дата;
		ДвижениеРасход.Номенклатура   = Номенклатура;
		ДвижениеРасход.Характеристика = Характеристика;
		ДвижениеРасход.ЗаказКлиента   = Выборка.ЗаказКлиента;
		ДвижениеРасход.ВЗаявке        = РаспределяемНаЗаказ;
		
		// Плюсуем стадию "ВПроизводстве"
		ДвижениеПриход = Движения.СтадииВыполненияЗаказов.ДобавитьПриход();
		ДвижениеПриход.Период        = Дата;
		ДвижениеПриход.Номенклатура   = Номенклатура;
		ДвижениеПриход.Характеристика = Характеристика;
		ДвижениеПриход.ЗаказКлиента   = Выборка.ЗаказКлиента;
		ДвижениеПриход.ВПроизводстве  = РаспределяемНаЗаказ;
		
		ОсталосьРаспределить = ОсталосьРаспределить - РаспределяемНаЗаказ;
		
	КонецЦикла;
	
	// 4. Если осталось количество (Перепроизводство относительно существующих заявок)
	Если ОсталосьРаспределить > 0 Тогда
		// Оставшийся излишек вешаем на пустой заказ (или на последний обработанный)
		ДвижениеИзлишек = Движения.СтадииВыполненияЗаказов.ДобавитьПриход();
		ДвижениеИзлишек.Период        = Дата;
		ДвижениеИзлишек.Номенклатура   = Номенклатура;
		ДвижениеИзлишек.Характеристика = Характеристика;
		ДвижениеИзлишек.ЗаказКлиента   = Документы.ЗаказКлиента.ПустаяСсылка();
		ДвижениеИзлишек.ВПроизводстве  = ОсталосьРаспределить;
	КонецЕсли;
	
КонецПроцедуры
