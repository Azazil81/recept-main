#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьПоСпецификации(Команда)
	ЗаполнитьПоСпецификацииНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьПоСпецификацииНаСервере()
	
	// Очищаем таблицы перед заполнением
	Объект.Состав.Очистить();
	Объект.СборкаКомплектов.Очистить();
	
	// Проверяем базовые заполненные реквизиты
	Если Не ЗначениеЗаполнено(Объект.Номенклатура) Тогда
		ВызватьИсключение "Не выбрана номенклатура выпуска!";
	КонецЕсли;
	
	// Сценарий 1: Производство комплекта
	Если Объект.НоменклатураМатериалы.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Комплект Тогда
		
		Если Не ЗначениеЗаполнено(Объект.Комплектация) Тогда
			ВызватьИсключение "Для комплекта необходимо выбрать Комплектацию!";
		КонецЕсли;
		
		// Читаем состав комплектации
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Комплектация", Объект.Комплектация);
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	КомплектацииСостав.Номенклатура,
			|	КомплектацииСостав.Характеристика,
			|	КомплектацииСостав.Количество * &КоэффициентВыпуска КАК Количество
			|ИЗ
			|	Справочник.Комплектации.Состав КАК КомплектацииСостав
			|ГДЕ
			|	КомплектацииСостав.Ссылка = &Комплектация";
		
		Запрос.УстановитьПараметр("КоэффициентВыпуска", Объект.Количество);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = Объект.СборкаКомплектов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		КонецЦикла;
		
	// Сценарий 2: Стандартное производство (Сырье + Услуги)
	Иначе
		
		Если Не ЗначениеЗаполнено(Объект.Спецификация) Тогда
			ВызватьИсключение "Выберите спецификацию (Эконом/Стандарт/Премиум) для заполнения!";
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Спецификация", Объект.Спецификация);
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	СпецификацииСостав.Номенклатура КАК Номенклатура,
			|	СпецификацииСостав.Характеристика КАК Характеристика,
			|	СпецификацииСостав.Количество КАК КоличествоНорма,
			|	СпецификацииСостав.РольКомпонента КАК РольКомпонента,
			|	СпецификацииСостав.ЭтоУслуга КАК ЭтоУслуга
			|ИЗ
			|	Справочник.Спецификации.Состав КАК СпецификацииСостав
			|ГДЕ
			|	СпецификацииСостав.Ссылка = &Спецификация";
			
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			НоваяСтрока = Объект.Состав.Добавить();
			
			// ОБРАБОТКА ИСТОРИЧЕСКИХ ДАННЫХ (Пустая строка в старых спецификациях)
			// Если в спецификации Номенклатура пустая — платформа создаст визуальный разделитель
			Если Не ЗначениеЗаполнено(Выборка.Номенклатура) И Не Выборка.ЭтоУслуга Тогда
				// Оставляем строку пустой для визуального разделения компонентов на форме
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока.Номенклатура    = Выборка.Номенклатура;
			НоваяСтрока.Характеристика  = Выборка.Характеристика;
			НоваяСтрока.РольКомпонента  = Выборка.РольКомпонента;
			
			// Логика для услуги "Переработка"
			Если Выборка.ЭтоУслуга Тогда
				НоваяСтрока.Количество = 1; // Согласно ТЗ: либо 1, либо пустая
				// Цена переработки может подтягиваться из регистра цен или заполняться вручную
				НоваяСтрока.Цена       = 0; 
				НоваяСтрока.Сумма      = 0;
			Иначе
				// Расчет сырья пропорционально объему производства
				НоваяСтрока.Количество = Выборка.КоличествоНорма * Объект.Количество;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти