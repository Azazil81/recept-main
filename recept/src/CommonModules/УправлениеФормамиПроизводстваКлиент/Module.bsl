// Вызывается при изменении Номенклатуры в строке ТЧ
Процедура НоменклатураПриИзмененииСтроки(ТекущиеДанные) Экспорт
	
	// Если номенклатуру очистили или поменяли — старые характеристики и партии больше не валидны
	ТекущиеДанные.Характеристика = ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка");
	Если СтруктураСвойствОбъекта(ТекущиеДанные, "Партия") Тогда
		ТекущиеДанные.Партия = ПредопределенноеЗначение("Справочник.Партии.ПустаяСсылка");
	КонецЕсли;
	
КонецПроцедуры

// Вызывается при нажатии на выпадающий список Характеристики.
// Гарантирует отбор строго по выбранной Номенклатуре.
Процедура ХарактеристикаНачалоВыбораСтроки(Элемент, ТекущиеДанные, СтандартнаяОбработка) Экспорт
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Задаем динамический фильтр для списка выбора
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.Владелец", ТекущиеДанные.Номенклатура));
	
	Элемент.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметров);
	
КонецПроцедуры

// Вспомогательная функция проверки наличия реквизита в ТЧ (чтобы модуль подходил для разных ТЧ)
Функция СтруктураСвойствОбъекта(Объект, ИмяРеквизита)
	Попытка
		Тест = Объект[ИмяРеквизита];
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции