// Процедура динамически настраивает правила отображения ячеек в ТЧ
Процедура НастроитьУсловноеОформлениеХарактеристик(Форма, ИмяТабличнойЧасти) Экспорт
	
	// ПРАВИЛО 1: Если Партия заполнена -> Характеристика недоступна для редактирования
	ЭлементОформления = Форма.УсловноеОформление.Элементы.Добавить();
	
	// Какое поле оформляем
	ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных(ИмяТабличнойЧасти + "Характеристика");
	
	// Условие: Партия ЗАПОЛНЕНА
	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Объект." + ИмяТабличнойЧасти + ".Партия");
	ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.Заполнено;
	
	// Что делаем: Включаем ТолькоПросмотр
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	// -------------------------------------------------------------------------
	// ПРАВИЛО 2: Если Номенклатура НЕ заполнена -> Характеристика недоступна для выбора
	ЭлементОформленияПустаяНоменклатура = Форма.УсловноеОформление.Элементы.Добавить();
	
	ПолеОформления2 = ЭлементОформленияПустаяНоменклатура.Поля.Элементы.Добавить();
	ПолеОформления2.Поле = Новый ПолеКомпоновкиДанных(ИмяТабличнойЧасти + "Характеристика");
	
	// Условие: Номенклатура НЕ ЗАПОЛНЕНА
	ЭлементОтбора2 = ЭлементОформленияПустаяНоменклатура.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора2.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Объект." + ИмяТабличнойЧасти + ".Номенклатура");
	ЭлементОтбора2.ВидСравнения   = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	ЭлементОформленияПустаяНоменклатура.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
КонецПроцедуры