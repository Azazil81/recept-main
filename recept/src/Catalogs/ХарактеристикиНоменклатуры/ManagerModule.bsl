
Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	Если ПустаяСтрока(Параметры.СтрокаПоиска) Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	ДанныеВыбора = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 50
		|	Характеристики.Ссылка КАК Ссылка,
		|	Характеристики.Наименование КАК Наименование,
		|	Характеристики.Владелец.Наименование КАК Номенклатура
		|ИЗ
		|	Справочник.ХарактеристикиНоменклатуры КАК Характеристики
		|ГДЕ
		|	(Характеристики.Наименование ПОДОБНО &СтрокаПоиска
		|	ИЛИ Характеристики.Владелец.Наименование ПОДОБНО &СтрокаПоиска)
		|	И (&ОтборПоВладельцуПуст ИЛИ Характеристики.Владелец = &ОтборВладелец)";
	
	// Знак процента с обеих сторон позволяет искать текст в любом месте наименования
	Запрос.УстановитьПараметр("СтрокаПоиска", "%" + Параметры.СтрокаПоиска + "%");
	
	ОтборПоВладельцу = Неопределено;
	Параметры.Отбор.Свойство("Владелец", ОтборПоВладельцу);
	
	Если ЗначениеЗаполнено(ОтборПоВладельцу) Тогда
		Запрос.УстановитьПараметр("ОтборПоВладельцуПуст", Ложь);
		Запрос.УстановитьПараметр("ОтборВладелец", ОтборПоВладельцу);
	Иначе
		Запрос.УстановитьПараметр("ОтборПоВладельцуПуст", Истина);
		Запрос.УстановитьПараметр("ОтборВладелец", Неопределено);
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СтрокаСписка = Строка(Выборка.Номенклатура) + " " + Строка(Выборка.Наименование);
		ДанныеВыбора.Добавить(Выборка.Ссылка, СокрЛП(СтрокаСписка));
		
	КонецЦикла;


КонецПроцедуры




Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	// Отключаем типовую логику (которая берет только Наименование)
    СтандартнаяОбработка = Ложь;
    
    // Указываем платформе, какие поля из БД нужно получить для формирования строки
    Поля.Добавить("Наименование");
    Поля.Добавить("Владелец");
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)

СтандартнаяОбработка = Ложь;
    
    // Получаем наименование характеристики (защита от пустых значений)
    ИмяХарактеристики = ?(ЗначениеЗаполнено(Данные.Наименование), Данные.Наименование, "<Без наименования>");
    
    // Получаем строковое представление владельца (Номенклатуры)
    ИмяВладельца = ?(ЗначениеЗаполнено(Данные.Владелец), Строка(Данные.Владелец), "<Без номенклатуры>");
    
    // Формируем итоговую строку. Например: "Красный, размер 42 [Футболка Поло]"
    Представление = ИмяВладельца + " " + ИмяХарактеристики;
    
КонецПроцедуры