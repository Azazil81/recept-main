#Область ОбработчикиСобытийФормы

// Управляет видимостью группы элементов формы в зависимости от типа номенклатуры.
//
// Параметры:
//   Отказ - Булево - признак запрета открытия формы
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если Объект.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Сырье") Тогда 
		Элементы.Группа3.Видимость 		= Истина;
	Иначе
		Элементы.Группа3.Видимость 		= Ложь;
	КонецЕсли;
КонецПроцедуры

// Проверяет заполнение группы номенклатуры перед записью и прерывает запись, если группа не заполнена.
//
// Параметры:
//   Отказ - Булево - признак отказа от записи
//   ПараметрыЗаписи - Структура - параметры записи стандартного объекта
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если Не ЗначениеЗаполнено(Объект.Родитель) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не заполнена группа номенклатуры!";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Управляет видимостью элементов формы и устанавливает значения полей в зависимости от выбранного типа номенклатуры.
//
// Параметры:
//   Элемент - ЭлементФормы - элемент управления, вызвавший событие
&НаКлиенте
Процедура ТипНоменклатурыПриИзменении(Элемент)
	Если Объект.ТипНоменклатуры 		= ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Сырье") Тогда 
		Элементы.Группа3.Видимость 		= Истина;
		Объект.ЕдиницаИзмеренияСырья 	= ПредопределенноеЗначение("Перечисление.ЕдиницыИзмерения.Килограмм");
		Объект.Родитель 				= ПредопределенноеЗначение("Справочник.НоменклатураМатериалы.Сырье");
				
	ИначеЕсли Объект.ТипНоменклатуры 	= ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Продукция") ИЛИ  
			  Объект.ТипНоменклатуры 	= ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Комплект") Тогда
		Элементы.Группа3.Видимость 		= Ложь;
		Объект.ЕдиницаИзмеренияСырья 	= ПредопределенноеЗначение("Перечисление.ЕдиницыИзмерения.Килограмм");
		Объект.Родитель 				= ПредопределенноеЗначение("Справочник.НоменклатураМатериалы.Продукция");
		
	ИначеЕсли Объект.ТипНоменклатуры 	= ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.УслугаРазделитель") Тогда
		Элементы.Группа3.Видимость 		= Ложь;
		Объект.ЕдиницаИзмеренияСырья 	= ПредопределенноеЗначение("Перечисление.ЕдиницыИзмерения.Услуга"); 
		//Объект.Родитель 				= ПредопределенноеЗначение("Справочник.НоменклатураМатериалы.Разделители");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти