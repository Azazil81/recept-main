  <attributes>
    <name>Список</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.ВходнойКонтроль</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	СпрНоменклатура.Ссылка КАК Номенклатура,
	ЕСТЬNULL(СпрХарактеристики.Ссылка, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Характеристика,
	
	// Данные из регистра
	ЕСТЬNULL(Остатки.Партия, НЕОПРЕДЕЛЕНО) КАК Партия,
	ЕСТЬNULL(Остатки.ВходнойКонтроль, ЛОЖЬ) КАК ВходнойКонтроль,
	ЕСТЬNULL(Остатки.ОстатокОстаток, 0) КАК СвободныйОстаток,
	
	// Формируем наименование для отображения
	СпрНоменклатура.Наименование + 
		ВЫБОР 
			КОГДА СпрХарактеристики.Ссылка ЕСТЬ NULL ТОГДА &quot;&quot; 
			ИНАЧЕ &quot; (&quot; + СпрХарактеристики.Наименование + &quot;)&quot; 
		КОНЕЦ КАК ТоварИХарактеристика
ИЗ
	Справочник.НоменклатураМатериалы КАК СпрНоменклатура
		
		// 1. Присоединяем все возможные характеристики для товара
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК СпрХарактеристики
		ПО СпрХарактеристики.Владелец = СпрНоменклатура.Ссылка
		И СпрХарактеристики.ПометкаУдаления = ЛОЖЬ
		
		// 2. Присоединяем остатки по паре Товар + Характеристика
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиМатериалов.Остатки(
			,
			Счет = ЗНАЧЕНИЕ(Документ.РасходнаяНакладная.ПустаяСсылка)
		) КАК Остатки
		ПО СпрНоменклатура.Ссылка = Остатки.Наименование
		И (ЕСТЬNULL(СпрХарактеристики.Ссылка, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) = Остатки.Характеристики)

ГДЕ
	СпрНоменклатура.ПометкаУдаления = ЛОЖЬ
	И СпрНоменклатура.ЭтоГруппа = ЛОЖЬ
	
	// Фильтр по типам (Товар и Набор)
	И СпрНоменклатура.ТипНоменклатуры В (
	    ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Продукция),
	    ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Комплект)
	)</queryText>
      <mainTable>Catalog.НоменклатураМатериалы</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Номенклатура</dataPath>
        <field>Номенклатура</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Наименование</dataPath>
        <field>Наименование</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Характеристики</dataPath>
        <field>Характеристики</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Партия</dataPath>
        <field>Партия</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Счет</dataPath>
        <field>Счет</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ВходнойКонтроль</dataPath>
        <field>ВходнойКонтроль</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>СвободныйОстаток</dataPath>
        <field>СвободныйОстаток</field>
        <title>
          <localValue>
            <content>
              <key>ru</key>
              <value>Свободный остаток</value>
            </content>
          </localValue>
        </title>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ТоварИХарактеристика</dataPath>
        <field>ТоварИХарактеристика</field>
        <title>
          <localValue>
            <content>
              <key>ru</key>
              <value>Товар и характеристика</value>
            </content>
          </localValue>
        </title>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Характеристика</dataPath>
        <field>Характеристика</field>
        <title>
          <localValue>
            <content>
              <key>ru</key>
              <value>Характеристика</value>
            </content>
          </localValue>
        </title>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Ссылка</dataPath>
        <field>Ссылка</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Код</dataPath>
        <field>Код</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ЕдиницаИзмеренияСырья</dataPath>
        <field>ЕдиницаИзмеренияСырья</field>
