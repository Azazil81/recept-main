
Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	// Если нет строки поиска, оставляем штатную работу выпадающего списка
	Если ПустаяСтрока(Параметры.СтрокаПоиска) Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	ДанныеВыбора = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	// Добавили получение Номенклатуры (Владелец.Владелец) и Характеристики (Владелец)
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 50
		|	Партии.Ссылка КАК Ссылка,
		|	Партии.Наименование КАК Наименование,
		|	Партии.Владелец.Владелец.Наименование КАК Номенклатура,
		|	Партии.Владелец.Наименование КАК Характеристика
		|ИЗ
		|	Справочник.Партии КАК Партии
		|ГДЕ
		|	Партии.Наименование ПОДОБНО &СтрокаПоиска
		|	И (&ОтборПоВладельцуПуст ИЛИ Партии.Владелец = &ОтборВладелец)";
	
	// Ищем по началу строки
	Запрос.УстановитьПараметр("СтрокаПоиска", Параметры.СтрокаПоиска + "%");
	
	// Учитываем отбор, если менеджер уже выбрал характеристику в документе
	ОтборПоВладельцу = Неопределено;
	Параметры.Отбор.Свойство("Владелец", ОтборПоВладельцу);
	
	Если ЗначениеЗаполнено(ОтборПоВладельцу) Тогда
		Запрос.УстановитьПараметр("ОтборПоВладельцуПуст", Ложь);
		Запрос.УстановитьПараметр("ОтборВладелец", ОтборПоВладельцу);
	Иначе
		Запрос.УстановитьПараметр("ОтборПоВладельцуПуст", Истина);
		Запрос.УстановитьПараметр("ОтборВладелец", Неопределено);
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		// Формируем нужный вид строки: "04123-33 EP-116 Белый 20кг"
		СтрокаСписка = Строка(Выборка.Наименование) + " " + 
					   Строка(Выборка.Номенклатура) + " " + 
					   Строка(Выборка.Характеристика);
					   
		ДанныеВыбора.Добавить(Выборка.Ссылка, СокрЛП(СтрокаСписка));
		
	КонецЦикла;

КонецПроцедуры


